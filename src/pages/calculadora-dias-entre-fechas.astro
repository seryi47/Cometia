---
import CalcLayout from '../layouts/CalcLayout.astro';
const faqs = [
  { q: '¿Cómo se cuentan los días entre dos fechas?', a: 'Restamos la fecha de inicio a la fecha de fin. El resultado es el número de días completos entre ambas. Puedes usarlo para plazos, vacaciones, cuentas atrás o cualquier periodo.' },
  { q: '¿Incluye el día final?', a: 'Mostramos los días de diferencia entre las dos fechas. Si necesitas contar también el último día, súmale uno al resultado.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Días entre dos fechas', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, url: 'https://cometia.es/calculadora-dias-entre-fechas' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<CalcLayout title="Calculadora de días entre dos fechas" description="Calcula cuántos días, semanas y meses hay entre dos fechas. Ideal para plazos, vacaciones y cuentas atrás. Gratis." path="/calculadora-dias-entre-fechas" jsonLd={jsonLd}>
  <div class="crumbs"><a href="/">Inicio</a> › Tiempo › Días entre fechas</div>
  <h1>Días entre dos fechas</h1>
  <p class="lead">Elige dos fechas y te decimos cuántos días, semanas y meses hay entre ellas.</p>
  <div class="calc">
    <div class="row">
      <div class="field"><label for="d1">Fecha de inicio</label><input class="input" id="d1" type="date" /></div>
      <div class="field"><label for="d2">Fecha de fin</label><input class="input" id="d2" type="date" /></div>
    </div>
    <button class="btn" id="go" type="button">Calcular</button>
    <div class="result" id="res" hidden>
      <div class="hint">Diferencia</div>
      <div class="result__big num" id="dias">—</div>
      <div style="margin-top:12px">
        <div class="result__row"><span>Semanas</span><strong class="num" id="sem">—</strong></div>
        <div class="result__row"><span>Meses (aprox.)</span><strong class="num" id="mes">—</strong></div>
      </div>
    </div>
  </div>
  <div class="adslot"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-6286326170489521" data-ad-slot="4016311751" data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script></div>
  <section class="prose">
    <h2>Para qué sirve</h2>
    <p>Contar días entre fechas es útil para plazos legales, días de vacaciones, tiempo hasta un evento o cuánto falta para una fecha. Introduce las dos fechas y el cálculo es inmediato.</p>
    <h2>Preguntas frecuentes</h2>
    {faqs.map((f) => (<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    <div class="more"><a href="/calculadora-edad">Calcular edad</a><a href="/calculadora-horas">Horas</a></div>
  </section>
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const nf = new Intl.NumberFormat('es-ES');
    function calc() {
      const v1 = ($('d1') as HTMLInputElement).value, v2 = ($('d2') as HTMLInputElement).value;
      if (!v1 || !v2) return;
      const ms = Math.abs(new Date(v2).getTime() - new Date(v1).getTime());
      const dias = Math.round(ms / 86400000);
      ($('dias')).textContent = nf.format(dias) + (dias === 1 ? ' día' : ' días');
      ($('sem')).textContent = nf.format(Math.floor(dias / 7)) + ' sem. ' + (dias % 7) + ' d';
      ($('mes')).textContent = (dias / 30.44).toFixed(1).replace('.', ',');
      ($('res')).hidden = false;
    }
    $('go').addEventListener('click', calc);
    ['d1','d2'].forEach((id) => $(id).addEventListener('change', calc));
  </script>
</CalcLayout>
