---
import CalcLayout from '../layouts/CalcLayout.astro';
import { CALCULADORAS, CATEGORIAS } from '../data/calculadoras';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Cometia',
    url: 'https://cometia.es',
    description: 'Calculadoras online gratis: hipoteca, IVA, IMC, sueldo neto, porcentajes y más. Rápidas, claras y sin registro.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Calculadoras online gratis — Cometia',
    url: 'https://cometia.es',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: CALCULADORAS.length,
      itemListElement: CALCULADORAS.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://cometia.es/${c.slug}`,
        name: c.titulo,
      })),
    },
  },
];
const meta = {
  Finanzas: { slug: 'finanzas', varName: 'fin' },
  Salud: { slug: 'salud', varName: 'sal' },
  Matemáticas: { slug: 'matematicas', varName: 'mat' },
  Tiempo: { slug: 'tiempo', varName: 'tie' },
} as const;
---
<CalcLayout
  title="Cometia — Calculadoras online gratis, rápidas y claras"
  description="Calculadoras online gratis: hipoteca, sueldo neto, IVA, IMC, interés compuesto, porcentajes y más. Respuesta al instante, sin registro y explicada paso a paso."
  path="/"
  jsonLd={jsonLd}
  wide={true}
>
  <section class="hero">
    <h1>La respuesta, <span class="grad">al instante</span></h1>
    <p>Calculadoras online gratis, claras y sin registro. Desde tu hipoteca hasta tu sueldo neto — escribe lo que buscas:</p>
    <div class="search"><input id="q" type="search" placeholder="Buscar calculadora… (hipoteca, IVA, edad)" autocomplete="off" aria-label="Buscar calculadora" /></div>
    <div class="pills">
      {CATEGORIAS.map((c) => (<a class="pill-cat" href={`#${meta[c].slug}`} style={`--c:var(--${meta[c].varName})`}>{c}</a>))}
    </div>
  </section>

  <div id="results">
    {CATEGORIAS.map((cat) => {
      const items = CALCULADORAS.filter((c) => c.cat === cat);
      if (!items.length) return null;
      const m = meta[cat];
      return (
        <section id={m.slug} class="catsection" style={`--c:var(--${m.varName})`}>
          <div class="catlabel"><span class="dot"></span>{cat}</div>
          <div class="grid">
            {items.map((c) => (
              <a class={`card card--${m.slug} calc-item`} href={`/${c.slug}`} data-name={`${c.titulo} ${c.meta}`.toLowerCase()}>
                <div class="card__icon">{c.icon}</div>
                <div class="card__t">{c.titulo}</div>
                <div class="card__d">{c.meta}</div>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>
  <p id="noresults" class="lead" style="text-align:center; display:none">No encontramos esa calculadora… todavía. Prueba con otra palabra.</p>

  <div class="adslot"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-6286326170489521" data-ad-slot="4016311751" data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script></div>

  <section class="prose">
    <h2>Calculadoras online gratis y fáciles de usar</h2>
    <p>
      En Cometia reunimos las <strong>calculadoras</strong> que más se buscan en el día a día:
      la <a href="/calculadora-hipoteca">cuota de tu hipoteca</a>, tu <a href="/calculadora-sueldo-neto">sueldo neto</a>,
      el <a href="/calculadora-iva">IVA</a> de una factura, tu <a href="/calculadora-imc">IMC</a>,
      el <a href="/calculadora-interes-compuesto">interés compuesto</a> de tus ahorros
      o cualquier <a href="/calculadora-porcentaje">porcentaje</a>. Todas funcionan al instante en el móvil o el ordenador,
      <strong>sin registro</strong> y con una explicación clara de cómo se hace el cálculo.
    </p>

    <h2>Qué encontrarás en Cometia</h2>
    <p>Hemos organizado las calculadoras en cuatro grandes áreas para que encuentres la que necesitas en segundos:</p>
    <ul>
      <li><strong>Finanzas.</strong> Todo lo que tiene que ver con tu dinero: la cuota de la hipoteca o de un préstamo, cuánto cobrarás de sueldo neto tras el IRPF y la Seguridad Social, el IVA de una factura, el interés compuesto de tus ahorros, el margen de un producto o cuánto cobrar la hora como autónomo.</li>
      <li><strong>Salud.</strong> Indicadores y estimaciones para tu día a día: el IMC, tus calorías diarias, el reparto de macronutrientes, las semanas de embarazo, el porcentaje de grasa corporal o tus zonas de frecuencia cardíaca. Siempre orientativas y nunca un sustituto del consejo médico.</li>
      <li><strong>Matemáticas.</strong> Desde lo más cotidiano —porcentajes, regla de tres, nota media— hasta lo más técnico: fracciones, ecuaciones de segundo grado, números primos, combinatoria o conversiones entre binario y decimal.</li>
      <li><strong>Tiempo.</strong> Días entre dos fechas, tu edad exacta, horas trabajadas, cuánto falta para una fecha señalada o en qué día de la semana cayó cualquier fecha.</li>
    </ul>

    <h2>Cómo funcionan nuestras calculadoras</h2>
    <p>Todos los cálculos se hacen <strong>en tu propio navegador</strong>, al instante y sin enviar tus datos a ningún servidor. Eso significa dos cosas: que el resultado aparece en cuanto escribes, y que lo que introduces (tu sueldo, tu peso o tus ahorros) no sale de tu dispositivo. No hace falta registrarse ni instalar nada.</p>
    <p>Cada calculadora incluye, además del resultado, una explicación de <strong>cómo se hace el cálculo</strong>, la fórmula empleada, ejemplos resueltos con números reales y una sección de preguntas frecuentes. Nuestro objetivo no es solo darte una cifra, sino que entiendas de dónde sale.</p>

    <h2>Precisión y rigor</h2>
    <p>Revisamos las fórmulas y los criterios de cada herramienta para que los resultados sean fiables: las calculadoras de salud siguen las referencias de organismos como la OMS, y las financieras aplican las fórmulas estándar de amortización e interés. Aun así, algunas herramientas ofrecen <strong>estimaciones orientativas</strong> —el sueldo neto, el finiquito o los indicadores de salud dependen de circunstancias personales— y no sustituyen el asesoramiento de un profesional. Cuando es así, lo indicamos con claridad en cada página.</p>

    <p class="hint">Cometia es un proyecto independiente. Si detectas un error o echas en falta una calculadora, puedes escribirnos desde la página de <a href="/contacto">contacto</a>.</p>
  </section>

  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const items = Array.from(document.querySelectorAll('.calc-item')) as HTMLElement[];
    const sections = Array.from(document.querySelectorAll('.catsection')) as HTMLElement[];
    const nore = document.getElementById('noresults') as HTMLElement;
    q.addEventListener('input', () => {
      const t = q.value.trim().toLowerCase();
      let visible = 0;
      items.forEach((el) => { const show = !t || (el.dataset.name || '').includes(t); el.style.display = show ? '' : 'none'; if (show) visible++; });
      sections.forEach((s) => { const any = Array.from(s.querySelectorAll('.calc-item')).some((el) => (el as HTMLElement).style.display !== 'none'); s.style.display = any ? '' : 'none'; });
      nore.style.display = visible ? 'none' : 'block';
    });
  </script>
</CalcLayout>
