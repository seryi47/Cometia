---
import CalcLayout from '../layouts/CalcLayout.astro';
const faqs = [
  { q: '¿Cómo se calcula la cuota de una hipoteca?', a: 'Con el sistema francés (el habitual en España), la cuota es fija cada mes y se obtiene con la fórmula: cuota = capital × i / (1 − (1 + i)^−n), donde i es el interés mensual (el anual dividido entre 12) y n el número de meses. Al principio pagas más intereses y menos capital; con el tiempo se invierte.' },
  { q: '¿Los intereses totales por qué son tan altos?', a: 'Porque durante los primeros años la mayor parte de la cuota va a intereses, no a amortizar capital. Cuanto más largo es el plazo, más intereses pagas en total, aunque la cuota mensual sea más baja.' },
  { q: '¿Esta calculadora incluye seguros y comisiones?', a: 'No. Calcula la cuota del préstamo (capital + intereses). Los seguros de hogar y vida, la comisión de apertura o la tasación se suman aparte según tu banco.' },
  { q: '¿Qué pasa si el interés sube o baja (hipoteca variable)?', a: 'Esta calculadora asume un interés fijo. En una hipoteca variable la cuota se recalcula al revisar el euríbor, así que el resultado es una estimación con el tipo que introduzcas.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Calculadora de hipoteca', applicationCategory: 'FinanceApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, url: 'https://cometia.es/calculadora-hipoteca' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<CalcLayout
  title="Calculadora de hipoteca 2026: cuota, intereses y amortización"
  description="Calcula gratis la cuota mensual de tu hipoteca, los intereses totales y la tabla de amortización año a año. Rápida, clara y sin registro."
  path="/calculadora-hipoteca"
  jsonLd={jsonLd}
>
  <div class="crumbs"><a href="/">Inicio</a> › Finanzas › Calculadora de hipoteca</div>
  <h1>Calculadora de hipoteca</h1>
  <p class="lead">Introduce el importe, el interés y el plazo, y calcula tu <strong>cuota mensual</strong>, los <strong>intereses totales</strong> y la <strong>tabla de amortización</strong>.</p>

  <div class="calc">
    <div class="row">
      <div class="field"><label for="c">Importe del préstamo (€)</label><input class="input" id="c" type="number" inputmode="decimal" value="150000" min="0" /></div>
      <div class="field"><label for="i">Interés anual (%)</label><input class="input" id="i" type="number" inputmode="decimal" value="3" step="0.01" min="0" /></div>
    </div>
    <div class="field"><label for="y">Plazo (años)</label><input class="input" id="y" type="number" inputmode="numeric" value="25" min="1" max="40" /></div>
    <button class="btn" id="go" type="button">Calcular cuota</button>

    <div class="result" id="res" hidden>
      <div class="hint">Cuota mensual</div>
      <div class="result__big num" id="cuota">—</div>
      <div style="margin-top:12px">
        <div class="result__row"><span>Intereses totales</span><strong class="num" id="int">—</strong></div>
        <div class="result__row"><span>Total a pagar</span><strong class="num" id="tot">—</strong></div>
        <div class="result__row"><span>Nº de cuotas</span><strong class="num" id="nc">—</strong></div>
      </div>
      <div class="tablewrap"><table class="amort"><thead><tr><th>Año</th><th>Intereses</th><th>Capital amortizado</th><th>Pendiente</th></tr></thead><tbody id="tbody"></tbody></table></div>
    </div>
  </div>

  <div class="adslot"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-6286326170489521" data-ad-slot="4016311751" data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script></div>

  <section class="prose">
    <h2>Cómo se calcula la cuota de la hipoteca</h2>
    <p>En España se usa el <strong>sistema de amortización francés</strong>: pagas una cuota fija cada mes durante todo el préstamo. La fórmula es:</p>
    <p style="text-align:center; font-variant-numeric:tabular-nums"><strong>cuota = C · i / (1 − (1 + i)<sup>−n</sup>)</strong></p>
    <p>Donde <strong>C</strong> es el capital prestado, <strong>i</strong> es el interés mensual (el interés anual dividido entre 12) y <strong>n</strong> el número total de meses (los años multiplicados por 12). Cada mes, una parte de la cuota paga intereses y otra amortiza capital; al principio pesan más los intereses y, con los años, cada vez amortizas más.</p>
    <h2>Ejemplo</h2>
    <p>Para una hipoteca de <strong>150.000 €</strong> a un <strong>3 %</strong> anual y <strong>25 años</strong>, la cuota ronda los <strong>711 €/mes</strong> y pagarías cerca de <strong>63.000 €</strong> en intereses a lo largo del préstamo. Baja el plazo o el interés y verás cuánto se reducen esos intereses totales.</p>
    <h2>Preguntas frecuentes</h2>
    {faqs.map((f) => (<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
  </section>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const eur = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const eur2 = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 2 });
    function calc() {
      const C = parseFloat(($('c') as HTMLInputElement).value) || 0;
      const ta = parseFloat(($('i') as HTMLInputElement).value) || 0;
      const y = parseInt(($('y') as HTMLInputElement).value) || 0;
      if (C <= 0 || y <= 0) return;
      const n = y * 12; const i = ta / 100 / 12;
      const cuota = i === 0 ? C / n : (C * i) / (1 - Math.pow(1 + i, -n));
      const total = cuota * n; const intereses = total - C;
      ($('cuota')).textContent = eur2.format(cuota);
      ($('int')).textContent = eur.format(intereses);
      ($('tot')).textContent = eur.format(total);
      ($('nc')).textContent = String(n);
      // tabla anual
      let saldo = C; const rows: string[] = [];
      for (let year = 1; year <= y; year++) {
        let intAnual = 0, capAnual = 0;
        for (let m = 0; m < 12; m++) {
          const intMes = saldo * i; const capMes = cuota - intMes;
          intAnual += intMes; capAnual += capMes; saldo -= capMes;
        }
        if (saldo < 0.01) saldo = 0;
        rows.push(`<tr><td>${year}</td><td>${eur.format(intAnual)}</td><td>${eur.format(capAnual)}</td><td>${eur.format(saldo)}</td></tr>`);
      }
      ($('tbody')).innerHTML = rows.join('');
      ($('res')).hidden = false;
    }
    $('go').addEventListener('click', calc);
    ['c', 'i', 'y'].forEach((id) => $(id).addEventListener('keydown', (e: any) => { if (e.key === 'Enter') calc(); }));
    calc();
  </script>
</CalcLayout>
