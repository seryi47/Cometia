---
import GuiaLayout from '../layouts/GuiaLayout.astro';
---
<GuiaLayout title="Página no encontrada — Cometia" description="Página no encontrada." lang="es" canonical="/404">
  <section class="ficha wrap" style="text-align:center; padding:70px 0">
    <h1>Vaya… esta página no existe</h1>
    <p class="ficha__sub">Puede que el enlace esté roto o el sitio ya no esté en la guía.</p>
    <p style="margin-top:22px"><a class="chip is-active" href="/">← Volver a la guía</a></p>
  </section>
</GuiaLayout>
