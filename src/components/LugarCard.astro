---
import { CATEGORIAS, descripcion, tipoLabel, esBritanico, fichaUrl, type Lugar } from '../data/guia/lugares';
import { t, type Lang } from '../i18n';
export interface Props { l: Lugar; lang: Lang; }
const { l, lang } = Astro.props;
const brit = esBritanico(l);
const href = fichaUrl(l.slug, lang);
const cuisine = l.cuisine ? l.cuisine.split(';')[0].replace(/_/g, ' ') : null;
const accent = [tipoLabel(l, lang), cuisine].filter(Boolean).join(' · ');
---
<a class="card lugar reveal" href={href}
   data-name={`${l.name} ${l.type} ${l.zone} ${l.cuisine || ''}`.toLowerCase()}
   data-tipo={l.type} data-zona={l.zone}>
  <div class={`card__media m-${l.type}${l.photo ? ' card__media--photo' : ' card__media--gradient'}`}>
    {l.photo
      ? <img class={`card__img${l.photo_fit === 'contain' ? ' is-contain' : ''}`} src={l.photo} alt={l.name} loading="lazy" />
      : <span class="card__ico" aria-hidden="true">{CATEGORIAS[l.type].icon}</span>}
    <div class="card__badges">
      {brit && <span class="pill pill--brit">🇬🇧 {t(lang, 'card_british')}</span>}
      {l.outdoor === 'yes' && <span class="pill pill--terr">🌤️ {t(lang, 'card_terrace')}</span>}
    </div>
    <span class="pill pill--type">{CATEGORIAS[l.type].icon} {tipoLabel(l, lang)}</span>
    <span class="card__zone">📍 {l.zone}</span>
  </div>
  <div class="card__body">
    <h3 class="card__name">{l.name}</h3>
    <p class="card__accent">{accent}</p>
    <p class="card__desc">{descripcion(l, lang) || ''}</p>
    <div class="card__foot">
      {cuisine && <span class="tagc">{cuisine}</span>}
      <span class="card__more">{t(lang, 'card_view')}</span>
    </div>
  </div>
</a>
