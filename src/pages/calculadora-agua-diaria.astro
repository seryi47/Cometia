---
import CalcLayout from '../layouts/CalcLayout.astro';
const faqs = [
  { q: '¿Cuánta agua hay que beber al día?', a: 'Una referencia habitual es de unos 30-35 ml por kilo de peso. Para una persona de 70 kg serían unos 2,1-2,5 litros al día, contando también el agua de alimentos y otras bebidas.' },
  { q: '¿Influyen el calor o el deporte?', a: 'Sí. Con calor, ejercicio intenso o fiebre necesitas más. La sed y el color de la orina (cuanto más clara, mejor) son buenas señales para ajustarte.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Calculadora de agua diaria', applicationCategory: 'HealthApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, url: 'https://cometia.es/calculadora-agua-diaria' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<CalcLayout title="Calculadora de agua diaria: cuánta agua beber al día" description="Calcula cuánta agua deberías beber al día según tu peso. Orientativo, gratis y sin registro." path="/calculadora-agua-diaria" jsonLd={jsonLd}>
  <div class="crumbs"><a href="/">Inicio</a> › Salud › Agua diaria</div>
  <h1>Calculadora de agua diaria</h1>
  <p class="lead">Introduce tu peso y te decimos cuánta agua beber al día, de forma orientativa.</p>
  <div class="calc">
    <div class="field"><label for="peso">Peso (kg)</label><input class="input" id="peso" type="number" inputmode="decimal" value="70" min="1" /></div>
    <button class="btn" id="go" type="button">Calcular</button>
    <div class="result" id="res" hidden>
      <div class="hint">Agua recomendada al día</div>
      <div class="result__big num" id="litros">—</div>
      <div style="margin-top:12px"><div class="result__row"><span>Equivale a</span><strong class="num" id="vasos">—</strong></div></div>
      <p class="hint">Orientativo. Incluye el agua de alimentos y otras bebidas.</p>
    </div>
  </div>
  <div class="adslot"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-6286326170489521" data-ad-slot="4016311751" data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script></div>
  <section class="prose">
    <h2>Cómo se calcula</h2>
    <p>Multiplicamos tu peso por unos 35 ml, una referencia general para adultos. El resultado lo mostramos en litros y en vasos de 250 ml para que sea fácil de seguir a lo largo del día.</p>
    <h2>Preguntas frecuentes</h2>
    {faqs.map((f) => (<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    <div class="more"><a href="/calculadora-calorias">Calorías diarias</a><a href="/calculadora-imc">IMC</a></div>
  </section>
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    function calc() {
      const peso = parseFloat(($('peso') as HTMLInputElement).value) || 0;
      if (peso <= 0) return;
      const ml = peso * 35;
      ($('litros')).textContent = (ml / 1000).toFixed(1).replace('.', ',') + ' litros';
      ($('vasos')).textContent = Math.round(ml / 250) + ' vasos de 250 ml';
      ($('res')).hidden = false;
    }
    $('go').addEventListener('click', calc);
    ($('peso')).addEventListener('keydown', (e: any) => { if (e.key === 'Enter') calc(); });
    calc();
  </script>
</CalcLayout>
