---
import GuiaLayout from '../layouts/GuiaLayout.astro';
import LugarCard from './LugarCard.astro';
import { CATEGORIAS, porZonaTipo, zonaUrl, zonaTipoUrl, tipoUrl, tipoPlural, altZonaTipo, fichaUrl, type TypeKey } from '../data/guia/lugares';
import { t, homeUrl, type Lang } from '../i18n';

export interface Props { zona: string; tipo: TypeKey; lang: Lang; }
const { zona, tipo, lang } = Astro.props;
const SITE = 'https://cometia.es';
const plural = tipoPlural(tipo, lang);
const pluralLow = plural.toLowerCase();
const places = porZonaTipo(zona, tipo).sort((a, b) => (b.photo ? 1 : 0) - (a.photo ? 1 : 0) || a.name.localeCompare(b.name));
const canonical = zonaTipoUrl(zona, tipo, lang);
const alternates = altZonaTipo(zona, tipo);
const h1 = t(lang, 'zt_best', { p: pluralLow, z: zona });
const intro = t(lang, 'zt_intro', { n: places.length, p: pluralLow, z: zona });
const title = `${plural} · ${zona} (${places.length}) — Cometia`;

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(lang, 'nav_home'), item: SITE + homeUrl(lang) },
    { '@type': 'ListItem', position: 2, name: zona, item: SITE + zonaUrl(zona, lang) },
    { '@type': 'ListItem', position: 3, name: plural, item: SITE + canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: h1, numberOfItems: places.length,
    itemListElement: places.slice(0, 25).map((l, i) => ({ '@type': 'ListItem', position: i + 1, name: l.name, url: SITE + fichaUrl(l.slug, lang) })) },
];
---
<GuiaLayout title={title} description={intro} lang={lang} canonical={canonical} alternates={alternates} jsonLd={jsonLd}>
  <section class="ficha wrap">
    <div class="crumbs"><a href={homeUrl(lang)}>{t(lang, 'nav_home')}</a> › <a href={zonaUrl(zona, lang)}>{zona}</a> › {plural}</div>
    <h1>{CATEGORIAS[tipo].icon} {h1}</h1>
    <p class="ficha__sub" style="max-width:760px">{intro}</p>
    <p class="count">{t(lang, 't_count', { n: places.length, p: pluralLow })}</p>

    <div class="grid">
      {places.map((l) => <LugarCard l={l} lang={lang} />)}
    </div>

    <p style="margin-top:26px;display:flex;gap:10px;flex-wrap:wrap">
      <a class="chip" href={zonaUrl(zona, lang)}>← {t(lang, 'zt_backzone', { z: zona })}</a>
      <a class="chip" href={tipoUrl(tipo, lang)}>{t(lang, 'zt_backtype', { p: plural })} →</a>
    </p>
  </section>
</GuiaLayout>
