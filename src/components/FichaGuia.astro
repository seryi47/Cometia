---
import GuiaLayout from '../layouts/GuiaLayout.astro';
import LugarCard from './LugarCard.astro';
import { CATEGORIAS, descripcion, tipoLabel, tipoPlural, direccion, esBritanico, zonaUrl, zonaTipoUrl, fichaUrl, altFicha, relacionados, type Lugar } from '../data/guia/lugares';
import { t, homeUrl, type Lang } from '../i18n';
export interface Props { l: Lugar; lang: Lang; }
const { l, lang } = Astro.props;
const SITE = 'https://cometia.es';
const desc = descripcion(l, lang);
const dir = direccion(l);
const brit = esBritanico(l);
const rel = relacionados(l, 6);
const canonical = fichaUrl(l.slug, lang);
const alternates = altFicha(l.slug);
const tl = tipoLabel(l, lang);
const gmaps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${l.name} ${l.street || ''} ${l.zone} Alicante`)}`;
const bbox = `${(l.lng - 0.004).toFixed(5)},${(l.lat - 0.003).toFixed(5)},${(l.lng + 0.004).toFixed(5)},${(l.lat + 0.003).toFixed(5)}`;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${l.lat},${l.lng}`;

const SCHEMA_TYPE: Record<string, string> = { restaurante: 'Restaurant', cafeteria: 'CafeOrCoffeeShop', bar: 'BarOrPub', pub: 'BarOrPub', 'comida-rapida': 'FastFoodRestaurant', cerveceria: 'BarOrPub' };
const jsonLd = [
  { '@context': 'https://schema.org', '@type': SCHEMA_TYPE[l.type] || 'FoodEstablishment', name: l.name, description: desc || undefined,
    image: l.photo ? SITE + l.photo : undefined,
    address: { '@type': 'PostalAddress', streetAddress: [l.street, l.housenumber].filter(Boolean).join(' ') || undefined, addressLocality: l.zone, postalCode: l.postcode || undefined, addressRegion: 'Alicante', addressCountry: 'ES' },
    geo: { '@type': 'GeoCoordinates', latitude: l.lat, longitude: l.lng },
    telephone: l.phone || undefined, url: l.website || undefined, servesCuisine: l.cuisine || undefined, hasMap: gmaps },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(lang, 'nav_home'), item: SITE + homeUrl(lang) },
    { '@type': 'ListItem', position: 2, name: l.zone, item: SITE + zonaUrl(l.zone, lang) },
    { '@type': 'ListItem', position: 3, name: tl, item: SITE + zonaTipoUrl(l.zone, l.type, lang) },
    { '@type': 'ListItem', position: 4, name: l.name, item: SITE + canonical },
  ] },
];
const title = `${l.name} — ${tl} · ${l.zone} | Cometia`;
const description = desc || `${l.name}, ${tl} · ${l.zone} (Costa Blanca).`;
---
<GuiaLayout title={title} description={description} lang={lang} canonical={canonical} alternates={alternates} image={l.photo || undefined} jsonLd={jsonLd}>
  <section class="ficha wrap">
    <div class="crumbs">
      <a href={homeUrl(lang)}>{t(lang, 'nav_home')}</a> › <a href={zonaUrl(l.zone, lang)}>{l.zone}</a> ›
      <a href={zonaTipoUrl(l.zone, l.type, lang)}>{tl}</a> › {l.name}
    </div>

    <div class="ficha__head"><h1>{l.name}</h1></div>
    <p class="ficha__sub">{CATEGORIAS[l.type].icon} {tl}{l.cuisine ? ` · ${l.cuisine}` : ''} · 📍 {l.zone}</p>

    <div class="badges">
      <span class="badge">{tl}</span>
      {brit && <span class="badge badge--brit">🇬🇧 {t(lang, 'card_british')}-friendly</span>}
      {l.outdoor === 'yes' && <span class="badge badge--terr">🌤️ {t(lang, 'card_terrace')}</span>}
    </div>

    {l.photo && (
      <figure class="ficha__photo">
        <img src={l.photo} alt={`${l.name} — ${tl}, ${l.zone}`} class={l.photo_fit === 'contain' ? 'is-contain' : ''} loading="eager" fetchpriority="high" decoding="async" />
        {l.photo_credit && <figcaption>{l.photo_credit}</figcaption>}
      </figure>
    )}

    <div class="ficha__layout">
      <div class="prose">
        {desc && <p>{desc}</p>}
        <h2>{t(lang, 'f_howto')}</h2>
        <iframe class="mapembed" src={mapSrc} title={`${t(lang, 'f_howto')} — ${l.name}`} loading="lazy"></iframe>
      </div>
      <aside class="panel">
        <h2>{t(lang, 'f_details')}</h2>
        <ul class="info">
          <li><span class="k">📍</span> <span>{dir}</span></li>
          {l.opening_hours && <li><span class="k">🕒</span> <span>{l.opening_hours}</span></li>}
          {l.phone && <li><span class="k">📞</span> <a href={`tel:${l.phone.replace(/\s/g, '')}`}>{l.phone}</a></li>}
          {l.website && <li><span class="k">🌐</span> <a href={l.website} target="_blank" rel="noopener nofollow">{t(lang, 'f_website')}</a></li>}
          {l.cuisine && <li><span class="k">🍴</span> <span>{l.cuisine}</span></li>}
        </ul>
        <a class="btn" href={gmaps} target="_blank" rel="noopener">{t(lang, 'f_gmaps')}</a>
        <a class="btn btn--ghost" href={zonaUrl(l.zone, lang)}>{t(lang, 'f_more', { z: l.zone })}</a>
      </aside>
    </div>

    {rel.length > 0 && (
      <div class="section" style="padding-top:22px">
        <div class="sec__head">
          <h2>{t(lang, 'f_related', { z: l.zone })}</h2>
          <a class="sec__link" href={zonaTipoUrl(l.zone, l.type, lang)}>{t(lang, 'f_seealltype', { p: tipoPlural(l.type, lang).toLowerCase(), z: l.zone })}</a>
        </div>
        <div class="grid">{rel.map((r) => <LugarCard l={r} lang={lang} />)}</div>
      </div>
    )}
  </section>
</GuiaLayout>
