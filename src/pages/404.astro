---
import CalcLayout from '../layouts/CalcLayout.astro';
import { CALCULADORAS } from '../data/calculadoras';
const populares = CALCULADORAS.filter((c) => ['calculadora-hipoteca', 'calculadora-sueldo-neto', 'calculadora-iva', 'calculadora-imc', 'calculadora-porcentaje', 'calculadora-edad'].includes(c.slug));
---
<CalcLayout title="Página no encontrada — Cometia" description="La página que buscas no existe. Descubre las calculadoras de Cometia." path="/404">
  <div class="hero" style="margin-bottom:24px">
    <h1>Vaya… esta página no existe</h1>
    <p>Pero seguro que encuentras la calculadora que buscabas. Prueba con una de estas:</p>
  </div>
  <div class="grid">
    {populares.map((c) => (
      <a class="card" href={`/${c.slug}`}>
        <div class="card__icon">{c.icon}</div>
        <div class="card__t">{c.titulo}</div>
        <div class="card__d">{c.meta}</div>
      </a>
    ))}
  </div>
  <p style="text-align:center; margin-top:26px"><a href="/">← Volver al inicio</a></p>
</CalcLayout>
