---
import CalcLayout from '../layouts/CalcLayout.astro';
const faqs = [
  { q: '¿Qué es el ROI o rentabilidad?', a: 'El ROI (retorno de la inversión) mide cuánto ganas respecto a lo que invertiste, en porcentaje. Se calcula como (valor final − inversión) ÷ inversión × 100.' },
  { q: '¿Un ROI del 20 % es bueno?', a: 'Depende del plazo y del riesgo. Un 20 % en un año es alto; el mismo 20 % en diez años es modesto. Compáralo siempre con el tiempo y las alternativas.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Calculadora de rentabilidad (ROI)', applicationCategory: 'FinanceApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, url: 'https://cometia.es/calculadora-rentabilidad' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<CalcLayout title="Calculadora de rentabilidad (ROI) de una inversión" description="Calcula la rentabilidad (ROI) de una inversión en porcentaje a partir de lo invertido y el valor final. Gratis y al instante." path="/calculadora-rentabilidad" jsonLd={jsonLd}>
  <div class="crumbs"><a href="/">Inicio</a> › Finanzas › Rentabilidad (ROI)</div>
  <h1>Calculadora de rentabilidad (ROI)</h1>
  <p class="lead">Calcula cuánto has ganado con una inversión, en euros y en porcentaje.</p>
  <div class="calc">
    <div class="row">
      <div class="field"><label for="i">Inversión inicial (€)</label><input class="input" id="i" type="number" inputmode="decimal" value="1000" min="0" /></div>
      <div class="field"><label for="f">Valor final (€)</label><input class="input" id="f" type="number" inputmode="decimal" value="1300" min="0" /></div>
    </div>
    <button class="btn" id="go" type="button">Calcular ROI</button>
    <div class="result" id="res" hidden>
      <div class="hint">Rentabilidad (ROI)</div>
      <div class="result__big num" id="roi">—</div>
      <div style="margin-top:12px"><div class="result__row"><span>Beneficio</span><strong class="num" id="ben">—</strong></div></div>
    </div>
  </div>
  <div class="adslot"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-6286326170489521" data-ad-slot="4016311751" data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script></div>
  <section class="prose">
    <h2>Cómo se calcula</h2>
    <p>El beneficio es el valor final menos lo invertido. La rentabilidad (ROI) es ese beneficio dividido entre la inversión, en porcentaje. Por ejemplo, invertir 1.000 € y recuperar 1.300 € da un beneficio de 300 € y un ROI del 30 %.</p>
    <h2>Preguntas frecuentes</h2>
    {faqs.map((f) => (<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
  </section>
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const eur = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 2 });
    function calc() {
      const inv = parseFloat(($('i') as HTMLInputElement).value) || 0;
      const fin = parseFloat(($('f') as HTMLInputElement).value) || 0;
      const ben = fin - inv;
      ($('ben')).textContent = eur.format(ben);
      ($('roi')).textContent = inv > 0 ? (ben / inv * 100).toFixed(1).replace('.', ',') + ' %' : '—';
      ($('res')).hidden = false;
    }
    $('go').addEventListener('click', calc);
    ['i','f'].forEach((id) => $(id).addEventListener('keydown', (e: any) => { if (e.key === 'Enter') calc(); }));
    calc();
  </script>
</CalcLayout>
