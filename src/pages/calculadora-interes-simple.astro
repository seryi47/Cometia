---
import CalcLayout from '../layouts/CalcLayout.astro';
const faqs = [
  { q: '¿Qué es el interés simple?', a: 'Es el interés que se calcula siempre sobre el capital inicial, sin acumular los intereses generados. La fórmula es I = C × r × t, con C el capital, r el tipo (en tanto por uno) y t el tiempo en años.' },
  { q: '¿En qué se diferencia del interés compuesto?', a: 'En el interés simple los intereses no generan a su vez más intereses; en el compuesto sí. A largo plazo, el compuesto crece mucho más.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Calculadora de interés simple', applicationCategory: 'FinanceApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, url: 'https://cometia.es/calculadora-interes-simple' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<CalcLayout title="Calculadora de interés simple" description="Calcula el interés simple de un capital según el tipo de interés y el tiempo. Rápido, claro y gratis." path="/calculadora-interes-simple" jsonLd={jsonLd}>
  <div class="crumbs"><a href="/">Inicio</a> › Finanzas › Interés simple</div>
  <h1>Calculadora de interés simple</h1>
  <p class="lead">Calcula los intereses de un capital con la fórmula del interés simple.</p>
  <div class="calc">
    <div class="row">
      <div class="field"><label for="c">Capital (€)</label><input class="input" id="c" type="number" inputmode="decimal" value="5000" min="0" /></div>
      <div class="field"><label for="r">Interés anual (%)</label><input class="input" id="r" type="number" inputmode="decimal" value="4" step="0.01" min="0" /></div>
    </div>
    <div class="field"><label for="t">Tiempo (años)</label><input class="input" id="t" type="number" inputmode="decimal" value="3" step="0.1" min="0" /></div>
    <button class="btn" id="go" type="button">Calcular</button>
    <div class="result" id="res" hidden>
      <div class="hint">Interés generado</div>
      <div class="result__big num" id="int">—</div>
      <div style="margin-top:12px"><div class="result__row"><span>Capital + intereses</span><strong class="num" id="tot">—</strong></div></div>
    </div>
  </div>
  <div class="adslot"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-6286326170489521" data-ad-slot="4016311751" data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script></div>
  <section class="prose">
    <h2>Cómo se calcula</h2>
    <p>El interés simple es <strong>I = C · r · t</strong>: el capital por el tipo (en tanto por uno) por los años. Por ejemplo, 5.000 € al 4 % durante 3 años generan 5.000 × 0,04 × 3 = 600 € de intereses.</p>
    <h2>Preguntas frecuentes</h2>
    {faqs.map((f) => (<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    <div class="more"><a href="/calculadora-interes-compuesto">Interés compuesto</a><a href="/calculadora-prestamo">Préstamo</a></div>
  </section>
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const eur = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 2 });
    function calc() {
      const c = parseFloat(($('c') as HTMLInputElement).value) || 0;
      const r = parseFloat(($('r') as HTMLInputElement).value) || 0;
      const t = parseFloat(($('t') as HTMLInputElement).value) || 0;
      const i = c * (r / 100) * t;
      ($('int')).textContent = eur.format(i);
      ($('tot')).textContent = eur.format(c + i);
      ($('res')).hidden = false;
    }
    $('go').addEventListener('click', calc);
    ['c','r','t'].forEach((id) => $(id).addEventListener('keydown', (e: any) => { if (e.key === 'Enter') calc(); }));
    calc();
  </script>
</CalcLayout>
