---
import CalcLayout from '../layouts/CalcLayout.astro';
const faqs = [
  { q: '¿Cómo se calculan las calorías diarias?', a: 'Primero se calcula el metabolismo basal (las calorías que gastas en reposo) con la fórmula de Mifflin-St Jeor, a partir de tu sexo, edad, peso y altura. Luego se multiplica por un factor según tu nivel de actividad física.' },
  { q: '¿Cuántas calorías para adelgazar o engordar?', a: 'Para perder peso se suele restar unas 300-500 kcal al gasto de mantenimiento, y para ganar peso se suman. Hazlo de forma gradual y, si es posible, con ayuda de un profesional de la nutrición.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Calculadora de calorías', applicationCategory: 'HealthApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, url: 'https://cometia.es/calculadora-calorias' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<CalcLayout title="Calculadora de calorías diarias (mantenimiento, déficit)" description="Calcula cuántas calorías necesitas al día según tu edad, sexo, peso, altura y actividad. Mantenimiento, para adelgazar y para ganar peso." path="/calculadora-calorias" jsonLd={jsonLd}>
  <div class="crumbs"><a href="/">Inicio</a> › Salud › Calorías</div>
  <h1>Calculadora de calorías</h1>
  <p class="lead">Descubre cuántas <strong>calorías</strong> necesitas al día para mantenerte, adelgazar o ganar peso.</p>
  <div class="calc">
    <div class="field"><label>Sexo</label><div class="seg" id="sexo"><button type="button" data-s="h" aria-pressed="true">Hombre</button><button type="button" data-s="m" aria-pressed="false">Mujer</button></div></div>
    <div class="row">
      <div class="field"><label for="edad">Edad</label><input class="input" id="edad" type="number" inputmode="numeric" value="30" min="1" /></div>
      <div class="field"><label for="peso">Peso (kg)</label><input class="input" id="peso" type="number" inputmode="decimal" value="70" min="1" /></div>
    </div>
    <div class="row">
      <div class="field"><label for="altura">Altura (cm)</label><input class="input" id="altura" type="number" inputmode="numeric" value="175" min="1" /></div>
      <div class="field"><label for="act">Actividad</label><select class="input" id="act"><option value="1.2">Sedentario</option><option value="1.375" selected>Ligera (1-3 días)</option><option value="1.55">Moderada (3-5 días)</option><option value="1.725">Alta (6-7 días)</option><option value="1.9">Muy alta</option></select></div>
    </div>
    <button class="btn" id="go" type="button">Calcular calorías</button>
    <div class="result" id="res" hidden>
      <div class="hint">Mantenimiento</div>
      <div class="result__big num" id="mant">—</div>
      <div style="margin-top:12px">
        <div class="result__row"><span>Para adelgazar (−500)</span><strong class="num" id="def">—</strong></div>
        <div class="result__row"><span>Para ganar peso (+500)</span><strong class="num" id="sup">—</strong></div>
      </div>
    </div>
  </div>
  <div class="adslot"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-6286326170489521" data-ad-slot="4016311751" data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script></div>
  <section class="prose">
    <h2>Cómo se calcula</h2>
    <p>Usamos la fórmula de <strong>Mifflin-St Jeor</strong> para el metabolismo basal y la multiplicamos por tu factor de actividad. El resultado son las calorías de mantenimiento; a partir de ahí, un déficit adelgaza y un superávit ayuda a ganar peso. Es orientativo: consulta a un profesional para un plan personalizado.</p>
    <h2>Preguntas frecuentes</h2>
    {faqs.map((f) => (<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    <div class="more"><a href="/calculadora-imc">IMC</a><a href="/calculadora-peso-ideal">Peso ideal</a></div>
  </section>
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const nf = new Intl.NumberFormat('es-ES', { maximumFractionDigits: 0 });
    let sexo = 'h';
    document.querySelectorAll('#sexo button').forEach((b) => b.addEventListener('click', () => {
      sexo = (b as HTMLElement).dataset.s!;
      document.querySelectorAll('#sexo button').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.s === sexo)));
      calc();
    }));
    function calc() {
      const edad = parseFloat(($('edad') as HTMLInputElement).value) || 0;
      const peso = parseFloat(($('peso') as HTMLInputElement).value) || 0;
      const alt = parseFloat(($('altura') as HTMLInputElement).value) || 0;
      const act = parseFloat(($('act') as HTMLSelectElement).value) || 1.2;
      if (edad <= 0 || peso <= 0 || alt <= 0) return;
      const bmr = 10 * peso + 6.25 * alt - 5 * edad + (sexo === 'h' ? 5 : -161);
      const mant = bmr * act;
      ($('mant')).textContent = nf.format(mant) + ' kcal';
      ($('def')).textContent = nf.format(mant - 500) + ' kcal';
      ($('sup')).textContent = nf.format(mant + 500) + ' kcal';
      ($('res')).hidden = false;
    }
    $('go').addEventListener('click', calc);
    ['edad','peso','altura'].forEach((id) => $(id).addEventListener('keydown', (e: any) => { if (e.key === 'Enter') calc(); }));
    ($('act')).addEventListener('change', calc);
    calc();
  </script>
</CalcLayout>
