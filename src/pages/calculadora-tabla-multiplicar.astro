---
import CalcLayout from '../layouts/CalcLayout.astro';
const faqs = [
  { q: '¿Para qué sirve la tabla de multiplicar?', a: 'Es la base del cálculo mental. Saberla de memoria ayuda a multiplicar, dividir y resolver problemas mucho más rápido, sobre todo en primaria.' },
  { q: '¿Hasta qué número llega?', a: 'Mostramos la tabla del número que elijas del 1 al 10, que es el rango habitual que se aprende en el colegio.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Tabla de multiplicar', applicationCategory: 'EducationalApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, url: 'https://cometia.es/calculadora-tabla-multiplicar' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<CalcLayout title="Tabla de multiplicar de cualquier número" description="Genera la tabla de multiplicar de cualquier número al instante. Ideal para estudiar en primaria. Gratis." path="/calculadora-tabla-multiplicar" jsonLd={jsonLd}>
  <div class="crumbs"><a href="/">Inicio</a> › Matemáticas › Tabla de multiplicar</div>
  <h1>Tabla de multiplicar</h1>
  <p class="lead">Escribe un número y te generamos su tabla de multiplicar.</p>
  <div class="calc">
    <div class="field"><label for="n">Número</label><input class="input" id="n" type="number" inputmode="numeric" value="7" /></div>
    <button class="btn" id="go" type="button">Ver tabla</button>
    <div class="result" id="res" hidden><div id="tabla" style="font-size:1.15rem; line-height:2; font-variant-numeric:tabular-nums"></div></div>
  </div>
  <div class="adslot"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-6286326170489521" data-ad-slot="4016311751" data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script></div>
  <section class="prose">
    <h2>Aprender las tablas</h2>
    <p>Multiplicar es sumar un número varias veces: 7 × 3 es lo mismo que 7 + 7 + 7 = 21. Practicar las tablas del 1 al 10 hasta saberlas de memoria acelera muchísimo cualquier cálculo posterior.</p>
    <h2>Preguntas frecuentes</h2>
    {faqs.map((f) => (<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    <div class="more"><a href="/calculadora-porcentaje">Porcentajes</a><a href="/calculadora-regla-de-tres">Regla de tres</a></div>
  </section>
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    function calc() {
      const n = parseInt(($('n') as HTMLInputElement).value);
      if (isNaN(n)) return;
      let html = '';
      for (let i = 1; i <= 10; i++) html += `${n} × ${i} = <strong>${n * i}</strong><br>`;
      ($('tabla')).innerHTML = html;
      ($('res')).hidden = false;
    }
    $('go').addEventListener('click', calc);
    ($('n')).addEventListener('keydown', (e: any) => { if (e.key === 'Enter') calc(); });
    calc();
  </script>
</CalcLayout>
