---
import '../styles/calc.css';
interface Props { title: string; description: string; path: string; jsonLd?: any; wide?: boolean; }
const { title, description, path, jsonLd, wide } = Astro.props;
const site = 'https://cometia.es';
const canonical = site + path;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#5b5bf6" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6286326170489521" crossorigin="anonymous"></script>
  </head>
  <body>
    <header class="hd">
      <div class="hd__in">
        <a href="/" class="logo"><span class="logo__mark">🧮</span> Cometia</a>
        <nav>
          <a href="/#finanzas">Finanzas</a>
          <a href="/#salud">Salud</a>
          <a href="/#matematicas">Matemáticas</a>
          <a href="/#tiempo">Tiempo</a>
        </nav>
      </div>
    </header>

    <main class={wide ? 'wrap wrap--wide' : 'wrap'}>
      <slot />
    </main>

    <footer class="ft">
      <div class="ft__in">
        <span>© {new Date().getFullYear()} Cometia · Calculadoras online gratis</span>
        <a href="/sobre">Sobre Cometia</a>
        <a href="/privacidad">Privacidad</a>
        <a href="/aviso-legal">Aviso legal</a>
        <a href="/contacto">Contacto</a>
      </div>
    </footer>
  </body>
</html>
