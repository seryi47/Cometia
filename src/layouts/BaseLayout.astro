---
import '../styles/global.css';
import { brand } from '../config';

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Ruta relativa de la página, p.ej. "/aviso-legal" */
  path?: string;
}

const {
  title,
  description = brand.description,
  noindex = false,
  path = '/',
} = Astro.props;

const canonical = new URL(path, brand.url).href;
const ogImage = new URL('/og-default.png', brand.url).href;
const year = new Date().getFullYear();

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: brand.name,
  url: brand.url,
  email: brand.email,
  telephone: '+' + brand.whatsapp,
  description: brand.description,
  slogan: brand.tagline,
  logo: new URL('/apple-touch-icon.png', brand.url).href,
  image: ogImage,
  parentOrganization: {
    '@type': 'Organization',
    name: brand.parent,
  },
  areaServed: {
    '@type': 'Country',
    name: 'España',
  },
  knowsAbout: [
    'Auditoría web',
    'SEO',
    'Optimización de velocidad web (WPO)',
    'Core Web Vitals',
    'Accesibilidad web',
    'Rendimiento web',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'atención al cliente',
    email: brand.email,
    telephone: '+' + brand.whatsapp,
    availableLanguage: ['Spanish', 'es'],
    areaServed: 'ES',
  },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: brand.name,
  url: brand.url,
  inLanguage: 'es-ES',
  description: brand.description,
  publisher: { '@type': 'Organization', name: brand.name, url: brand.url },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f3eee3" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(orgJsonLd)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteJsonLd)}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="brand" aria-label="Cometia — inicio"><span class="brand__dot" aria-hidden="true"></span>cometia</a>
        <nav class="nav" aria-label="Navegación principal">
          <div class="nav__links">
            <a href="/#medimos">Qué revisamos</a>
            <a href="/#planes">Precios</a>
            <a href="/#velocidad">Velocidad</a>
            <a href="/guias">Guías</a>
            <a href="/#contacto">Contacto</a>
          </div>
          <a href="/#analizar" class="btn btn--primary">Analizar mi web</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer__top">
          <div class="footer__brand">
            <a href="/" class="brand" aria-label="Cometia — inicio"><span class="brand__dot" aria-hidden="true"></span>cometia</a>
            <p>
              Auditoría web y SEO exprés para pymes. Datos reales de Google,
              criterio experto y un plan de acción claro. Solo datos y criterio.
            </p>
          </div>
          <div class="footer__col">
            <h3>Cometia</h3>
            <ul>
              <li><a href="/#medimos">Qué medimos</a></li>
              <li><a href="/#planes">Precios</a></li>
              <li><a href="/guias">Guías</a></li>
              <li><a href="/#faq">Preguntas frecuentes</a></li>
            </ul>
          </div>
          <div class="footer__col">
            <h3>Legal y contacto</h3>
            <ul>
              <li><a href="/#contacto">Contacto</a></li>
              <li><a href={`mailto:${brand.email}`}>{brand.email}</a></li>
              <li><a href={`https://wa.me/${brand.whatsapp}`} target="_blank" rel="noopener">WhatsApp: {brand.whatsappDisplay}</a></li>
              <li><a href="/aviso-legal">Aviso legal</a></li>
              <li><a href="/privacidad">Política de privacidad</a></li>
            </ul>
          </div>
        </div>
        <div class="footer__bottom">
          <span>© {year} {brand.name}. Todos los derechos reservados.</span>
          <span class="footer__orbita">Un proyecto de Órbita Labs</span>
        </div>
      </div>
    </footer>

    <a
      class="wa-fab"
      href={`https://wa.me/${brand.whatsapp}?text=${encodeURIComponent('Hola, tengo una duda sobre Cometia.')}`}
      target="_blank"
      rel="noopener"
      aria-label={`Escríbenos por WhatsApp al ${brand.whatsappDisplay}`}
    >
      <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16.004 3.2c-7.06 0-12.8 5.74-12.8 12.8 0 2.26.6 4.46 1.73 6.4L3.2 28.8l6.57-1.72a12.74 12.74 0 0 0 6.23 1.6h.005c7.06 0 12.8-5.74 12.8-12.8s-5.74-12.8-12.8-12.8Zm0 23.36h-.004a10.54 10.54 0 0 1-5.37-1.47l-.385-.23-3.9 1.02 1.04-3.8-.25-.39a10.55 10.55 0 0 1-1.62-5.62c0-5.86 4.77-10.63 10.64-10.63 2.84 0 5.5 1.11 7.51 3.12a10.55 10.55 0 0 1 3.11 7.52c0 5.86-4.77 10.63-10.63 10.63Zm5.83-7.96c-.32-.16-1.89-.93-2.18-1.04-.29-.11-.5-.16-.72.16-.21.32-.82 1.04-1 1.25-.18.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.58-.95-.85-1.59-1.89-1.78-2.21-.18-.32-.02-.49.14-.65.15-.14.32-.37.48-.56.16-.18.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.72-1.74-.99-2.38-.26-.62-.52-.54-.72-.55l-.61-.01c-.21 0-.56.08-.85.4-.29.32-1.11 1.09-1.11 2.66 0 1.57 1.14 3.08 1.3 3.29.16.21 2.25 3.43 5.44 4.81.76.33 1.35.52 1.81.67.76.24 1.46.21 2 .13.61-.09 1.89-.77 2.16-1.52.27-.75.27-1.39.19-1.52-.08-.13-.29-.21-.61-.37Z"/></svg>
      <span class="wa-fab__txt">WhatsApp</span>
    </a>
  </body>
</html>
