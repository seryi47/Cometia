---
import GuiaLayout from '../../layouts/GuiaLayout.astro';
---
<GuiaLayout
  title="Contact — Cometia"
  description="Contact the Cometia guide: suggest a bar or restaurant, fix a detail, or get your venue featured."
  lang="en"
  canonical="/en/contact"
  altUrl="/contacto"
>
  <section class="ficha wrap">
    <h1>Contact</h1>
    <div class="prose" style="max-width:720px">
      <p>Is a bar or restaurant missing, have you spotted a wrong detail, or do you run a local venue and want to be featured? We'd love to hear from you.</p>
      <p><strong>Email:</strong> <a href="mailto:cometia.es@gmail.com">cometia.es@gmail.com</a></p>
      <p>We reply as soon as we can. Thanks for helping us improve the guide.</p>
    </div>
  </section>
</GuiaLayout>
