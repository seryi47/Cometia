import ZonaGuia from '../components/ZonaGuia.astro';
import { porZona } from '../data/guia/lugares';
const n = porZona('Alicante').length;
---
<GuiaLayout
  title="Bares y restaurantes en Alicante — Guía Cometia"
  description={`Guía de ${n} bares, restaurantes, pubs y cafeterías de Alicante capital. Con mapa y descripciones. Español e inglés.`}
