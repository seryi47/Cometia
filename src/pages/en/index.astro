---
import GuiaLayout from '../../layouts/GuiaLayout.astro';
import { LUGARES, CATEGORIAS, TYPE_ORDER, ZONAS, descripcion, tipoLabel, esBritanico, TOTAL } from '../../data/guia/lugares';

const lugares = [...LUGARES].sort((a, b) => a.name.localeCompare(b.name));
const porZona = (z: string) => LUGARES.filter((l) => l.zone === z).length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Bars & restaurants guide for Gran Alacant and Santa Pola',
  url: 'https://cometia.es/en/',
  inLanguage: 'en',
  about: 'Bars, restaurants, pubs and cafés in Gran Alacant, Santa Pola and around (Costa Blanca).',
};
---
<GuiaLayout
  title="Bars & restaurants in Gran Alacant and Santa Pola — Cometia Guide"
  description="The local guide to the best bars, restaurants, pubs and cafés in Gran Alacant, Santa Pola and around (Costa Blanca). With map, opening hours and honest descriptions. English & Spanish."
  lang="en"
  canonical="/en/"
  altUrl="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <h1>Where to eat & drink in <span class="grad">Gran Alacant & Santa Pola</span></h1>
      <p>The local guide to bars, restaurants, pubs and cafés in the area. {TOTAL} places with map, hours and details. <a href="/">En español →</a></p>
      <div class="search"><input id="q" type="search" placeholder="Search by name, type or area…" autocomplete="off" aria-label="Search" /></div>
      <div class="chips" id="chips">
        <button class="chip is-active" data-f="tipo" data-v="">All</button>
        {TYPE_ORDER.filter((t) => LUGARES.some((l) => l.type === t)).map((t) => (
          <button class="chip" data-f="tipo" data-v={t}>{CATEGORIAS[t].icon} {CATEGORIAS[t].plural_en}</button>
        ))}
      </div>
      <div class="chips">
        <button class="chip zona is-active" data-f="zona" data-v="">All areas</button>
        {ZONAS.map((z) => (<button class="chip zona" data-f="zona" data-v={z}>📍 {z} ({porZona(z)})</button>))}
      </div>
    </div>
  </section>

  <section class="wrap" id="lista">
    <p class="count"><span id="count">{lugares.length}</span> places</p>
    <div class="grid" id="grid">
      {lugares.map((l) => {
        const desc = descripcion(l, 'en') || '';
        const brit = esBritanico(l);
        return (
          <a class="card lugar" href={`/en/place/${l.slug}`}
             data-name={`${l.name} ${l.type} ${l.zone} ${l.cuisine || ''}`.toLowerCase()}
             data-tipo={l.type} data-zona={l.zone} data-brit={brit ? '1' : '0'}>
            <div class="card__top">
              <span class="card__ico">{CATEGORIAS[l.type].icon}</span>
              <span class="card__tag">{tipoLabel(l, 'en')}</span>
              {brit && <span class="card__tag card__tag--brit">🇬🇧 British-friendly</span>}
            </div>
            <h3>{l.name}</h3>
            <p class="card__zone">📍 {l.zone}</p>
            <p class="card__desc">{desc}</p>
            <span class="card__more">View details →</span>
          </a>
        );
      })}
    </div>
    <p class="noresults" id="noresults">No places match that filter. Try another word.</p>
  </section>

  <section class="section wrap">
    <h2>Browse by area</h2>
    <p class="lead">Pick your area and find where to eat, tapas or grab a drink.</p>
    <div class="zonecards">
      <a class="zonecard" href="/en/gran-alacant"><h3>Gran Alacant</h3><span>{porZona('Gran Alacant')} bars & restaurants</span></a>
      <a class="zonecard" href="/en/santa-pola"><h3>Santa Pola</h3><span>{porZona('Santa Pola')} bars & restaurants</span></a>
    </div>
  </section>

  <script>
    const cards = Array.from(document.querySelectorAll('.lugar')) as HTMLElement[];
    const q = document.getElementById('q') as HTMLInputElement;
    const countEl = document.getElementById('count')!;
    const noRes = document.getElementById('noresults')!;
    let fTipo = '', fZona = '', fText = '';
    function apply() {
      let n = 0;
      cards.forEach((c) => {
        const ok = (!fTipo || c.dataset.tipo === fTipo) && (!fZona || c.dataset.zona === fZona)
          && (!fText || (c.dataset.name || '').includes(fText));
        c.style.display = ok ? '' : 'none'; if (ok) n++;
      });
      countEl.textContent = String(n); noRes.style.display = n ? 'none' : 'block';
    }
    document.querySelectorAll('.chip').forEach((ch) => {
      ch.addEventListener('click', () => {
        const f = (ch as HTMLElement).dataset.f, v = (ch as HTMLElement).dataset.v || '';
        if (f === 'tipo') fTipo = v; else fZona = v;
        document.querySelectorAll(`.chip[data-f="${f}"]`).forEach((x) => x.classList.remove('is-active'));
        ch.classList.add('is-active'); apply();
      });
    });
    q.addEventListener('input', () => { fText = q.value.trim().toLowerCase(); apply(); });
    const params = new URLSearchParams(location.search);
    const pz = params.get('zona'), pt = params.get('tipo');
    if (pz) { const b = document.querySelector(`.chip[data-f="zona"][data-v="${CSS.escape(pz)}"]`) as HTMLElement; if (b) b.click(); }
    if (pt) { const b = document.querySelector(`.chip[data-f="tipo"][data-v="${CSS.escape(pt)}"]`) as HTMLElement; if (b) b.click(); }
  </script>
</GuiaLayout>
