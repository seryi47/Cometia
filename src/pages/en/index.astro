---
import GuiaLayout from '../../layouts/GuiaLayout.astro';
import { LUGARES, ZONAS, CATEGORIAS, TYPE_ORDER, TOTAL, N_FOTOS, porTipo, zonaUrl, tipoUrl } from '../../data/guia/lugares';
import LugarCard from '../../components/LugarCard.astro';

const porZona = (z: string) => LUGARES.filter((l) => l.zone === z).length;

const destacados = ZONAS.flatMap((z) => {
  const inZone = LUGARES.filter((l) => l.zone === z && l.photo).sort((a, b) => a.name.localeCompare(b.name));
  return inZone.slice(0, 6);
}).sort((a, b) => a.name.localeCompare(b.name));

const tipos = TYPE_ORDER.filter((t) => porTipo(t).length > 0);

const faqs = [
  { q: 'What is Cometia?', a: `Cometia is an independent local guide to bars, restaurants, pubs and cafés on the Costa Blanca: Gran Alacant, Santa Pola, Alicante and Elche. We bring together ${TOTAL} places with address, map, opening hours and a clear description of each, in English and Spanish.` },
  { q: 'Is it free?', a: 'Yes. Browsing the guide is completely free and needs no sign-up. We don’t sell rankings or publish fake reviews.' },
  { q: 'Where does the data come from?', a: 'Business data comes from OpenStreetMap (a free project, ODbL licence) and is enriched with geocoding. The descriptions are our own. Ratings, where shown, link out to Google.' },
  { q: 'Can I see the places on a map?', a: 'Yes. On the interactive map you can see every place on the plan, filter by type and area, and click a pin for the full listing with a photo.' },
];

const SITE = 'https://cometia.es';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Cometia', url: SITE + '/en/', inLanguage: 'en' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Cometia', url: SITE + '/', logo: SITE + '/favicon.svg',
    description: 'Bilingual local guide to bars and restaurants on the Costa Blanca (Gran Alacant, Santa Pola, Alicante and Elche).' },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Bars & restaurants guide for the Costa Blanca', url: SITE + '/en/', inLanguage: 'en' },
];
---
<GuiaLayout
  title="Bars & restaurants on the Costa Blanca — Cometia Guide"
  description={`Bilingual local guide to ${TOTAL} bars, restaurants, pubs and cafés in Gran Alacant, Santa Pola, Alicante and Elche. With interactive map, opening hours and descriptions. English & Spanish.`}
  lang="en"
  canonical="/en/"
  altUrl="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="hero__eyebrow">Your Costa Blanca guide</p>
      <h1>Where to eat & drink on <span class="grad">the Costa Blanca</span></h1>
      <p>Bars, restaurants, pubs and cafés in Gran Alacant, Santa Pola, Alicante and Elche. With map, opening hours and a listing for every place.</p>

      <div class="search-wrap">
        <div class="search"><input id="q" type="search" placeholder="Search for a bar or restaurant…" autocomplete="off" aria-label="Search place" role="combobox" aria-expanded="false" aria-controls="results" /><span class="loc">📍 Costa Blanca</span></div>
        <div class="results" id="results" role="listbox" aria-label="Results"></div>
      </div>

      <div class="hero__cta">
        <a class="btn-hero" href="/en/map">🗺️ Open the map</a>
        <a class="btn-hero btn-hero--ghost" href="#zonas">Browse by area</a>
      </div>

      <div class="stats">
        <div><b>{TOTAL}</b><span>places</span></div>
        <div><b>{ZONAS.length}</b><span>areas</span></div>
        <div><b>{N_FOTOS}</b><span>with photo</span></div>
        <div><b>EN · ES</b><span>bilingual</span></div>
      </div>
    </div>
  </section>

  <section class="section wrap" id="zonas">
    <h2>Browse by area</h2>
    <p class="lead">Pick your town and find every place to eat, have tapas or grab a drink.</p>
    <div class="zonecards">
      {ZONAS.map((z) => (
        <a class="zonecard reveal" href={zonaUrl(z, 'en')}>
          <h3>{z}</h3><span>{porZona(z)} bars & restaurants</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <h2>Browse by type</h2>
    <p class="lead">Restaurants, tapas bars, pubs, cafés and more — right across the Costa Blanca.</p>
    <div class="typetiles">
      {tipos.map((t) => (
        <a class="typetile reveal" href={tipoUrl(t, 'en')}>
          <span class="ic">{CATEGORIAS[t].icon}</span>
          <span><b>{CATEGORIAS[t].plural_en}</b><span>{porTipo(t).length} places</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap" id="destacados">
    <div class="sec__head"><h2 style="font-family:var(--display);font-size:2.1rem;margin:0">Featured places</h2><a class="sec__link" href="/en/map">See them all on the map →</a></div>
    <div class="grid">
      {destacados.map((l) => <LugarCard l={l} lang="en" />)}
    </div>
  </section>

  <section class="section wrap">
    <div class="mapband reveal">
      <h2>🗺️ Every place on one map</h2>
      <p>Explore all {TOTAL} bars and restaurants on the plan. Filter by type and area and click a pin for photos and the full listing.</p>
      <a class="btn-hero" href="/en/map">Open the interactive map</a>
    </div>
  </section>

  <section class="section wrap">
    <h2>Why Cometia</h2>
    <div class="feats">
      <div class="feat reveal"><div class="ic">🍽️</div><h3>All in one place</h3><p>{TOTAL} bars and restaurants on the Costa Blanca with address, opening hours, map and contact.</p></div>
      <div class="feat reveal"><div class="ic">🇬🇧🇪🇸</div><h3>Bilingual</h3><p>Every listing in English and Spanish, made with the local British community in mind too.</p></div>
      <div class="feat reveal"><div class="ic">✅</div><h3>No nonsense</h3><p>Real data from OpenStreetMap and our own descriptions. No fake reviews, no rankings for sale.</p></div>
      <div class="feat reveal"><div class="ic">🗺️</div><h3>On the map</h3><p>Find what’s near you with the interactive map and filters by type and area.</p></div>
    </div>
  </section>

  <section class="section wrap">
    <h2>Frequently asked questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      var q = document.getElementById('q');
      var box = document.getElementById('results');
      if (!q || !box) return;
      var base = '/en/place/';
      var TL = { restaurante: ['🍽️', 'Restaurant'], bar: ['🍺', 'Bar'], pub: ['🍻', 'Pub'], cafeteria: ['☕', 'Café'], 'comida-rapida': ['🍔', 'Fast food'], cerveceria: ['🍺', 'Beer garden'] };
      var idx = [], hi = -1, cur = [];
      function esc(s) { return String(s).replace(/[&<>"]/g, function (m) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]; }); }
      var loaded = false;
      function load() { if (loaded) return; loaded = true; fetch('/search-index.json').then(function (r) { return r.json(); }).then(function (d) { idx = d; run(); }); }
      function run() {
        var v = q.value.trim().toLowerCase();
        if (v.length < 2) { close(); return; }
        var starts = [], has = [];
        for (var i = 0; i < idx.length && has.length < 40; i++) {
          var n = idx[i].n.toLowerCase();
          if (n.indexOf(v) === 0) starts.push(idx[i]);
          else if (n.indexOf(v) > -1 || idx[i].z.toLowerCase().indexOf(v) > -1) has.push(idx[i]);
        }
        cur = starts.concat(has).slice(0, 8); hi = -1;
        if (!cur.length) { box.innerHTML = '<div class="empty">No results for “' + esc(q.value.trim()) + '”.</div>'; box.classList.add('is-open'); q.setAttribute('aria-expanded', 'true'); return; }
        box.innerHTML = cur.map(function (r) {
          var tl = TL[r.t] || ['📍', ''];
          return '<a class="result" role="option" href="' + base + r.s + '"><span class="ic">' + tl[0] + '</span><span class="nm">' + esc(r.n) + '</span><span class="mt">' + tl[1] + ' · ' + esc(r.z) + '</span></a>';
        }).join('');
        box.classList.add('is-open'); q.setAttribute('aria-expanded', 'true');
      }
      function close() { box.classList.remove('is-open'); q.setAttribute('aria-expanded', 'false'); hi = -1; }
      function move(d) { var els = box.querySelectorAll('.result'); if (!els.length) return; hi = (hi + d + els.length) % els.length; els.forEach(function (e, i) { e.classList.toggle('is-hi', i === hi); }); }
      q.addEventListener('focus', load);
      q.addEventListener('input', function () { if (loaded) run(); else load(); });
      q.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
        else if (e.key === 'Enter') { var els = box.querySelectorAll('.result'); if (hi > -1 && els[hi]) { location.href = els[hi].getAttribute('href'); } }
        else if (e.key === 'Escape') { close(); }
      });
      document.addEventListener('click', function (e) { if (!box.contains(e.target) && e.target !== q) close(); });
    })();
  </script>
</GuiaLayout>
