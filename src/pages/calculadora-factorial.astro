---
import CalcLayout from '../layouts/CalcLayout.astro';
const faqs = [
  { q: '¿Qué es el factorial de un número?', a: 'El factorial de n (se escribe n!) es el producto de todos los números enteros desde 1 hasta n. Por ejemplo, 5! = 5 × 4 × 3 × 2 × 1 = 120.' },
  { q: '¿Cuánto vale 0!?', a: 'Por convención, 0! = 1. Es una definición que hace que muchas fórmulas de combinatoria funcionen correctamente.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Calculadora de factorial', applicationCategory: 'EducationalApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, url: 'https://cometia.es/calculadora-factorial' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<CalcLayout title="Calculadora de factorial (n!)" description="Calcula el factorial de un número (n!) al instante, incluso de números grandes. Gratis y con explicación." path="/calculadora-factorial" jsonLd={jsonLd}>
  <div class="crumbs"><a href="/">Inicio</a> › Matemáticas › Factorial</div>
  <h1>Calculadora de factorial</h1>
  <p class="lead">Introduce un número y calculamos su factorial (n!).</p>
  <div class="calc">
    <div class="field"><label for="n">Número (n)</label><input class="input" id="n" type="number" inputmode="numeric" value="10" min="0" max="1000" /></div>
    <button class="btn" id="go" type="button">Calcular n!</button>
    <div class="result" id="res" hidden><div class="hint">Resultado</div><div class="result__big num" id="out" style="font-size:1.4rem; word-break:break-all">—</div></div>
  </div>
  <div class="adslot"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-6286326170489521" data-ad-slot="4016311751" data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script></div>
  <section class="prose">
    <h2>Cómo se calcula</h2>
    <p>Multiplicamos todos los enteros desde 1 hasta el número que indiques. El factorial crece muy rápido: 10! ya son más de tres millones y medio. Es clave en probabilidad y combinatoria (permutaciones y combinaciones).</p>
    <h2>Preguntas frecuentes</h2>
    {faqs.map((f) => (<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
  </section>
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    function calc() {
      const n = parseInt(($('n') as HTMLInputElement).value);
      if (isNaN(n) || n < 0) return;
      if (n > 1000) { ($('out')).textContent = 'Prueba con un número hasta 1000'; ($('res')).hidden = false; return; }
      let r = 1n;
      for (let i = 2n; i <= BigInt(n); i++) r *= i;
      ($('out')).textContent = r.toString();
      ($('res')).hidden = false;
    }
    $('go').addEventListener('click', calc);
    ($('n')).addEventListener('keydown', (e: any) => { if (e.key === 'Enter') calc(); });
    calc();
  </script>
</CalcLayout>
