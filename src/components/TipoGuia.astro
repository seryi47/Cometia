---
import GuiaLayout from '../layouts/GuiaLayout.astro';
import LugarCard from './LugarCard.astro';
import { LUGARES, ZONAS, CATEGORIAS, porTipo, porZonaTipo, tipoUrl, tipoPlural, zonaTipoUrl, altTipo, fichaUrl, type TypeKey } from '../data/guia/lugares';
import { t, homeUrl, type Lang } from '../i18n';

export interface Props { tipo: TypeKey; lang: Lang; }
const { tipo, lang } = Astro.props;
const SITE = 'https://cometia.es';
const plural = tipoPlural(tipo, lang);
const pluralLow = plural.toLowerCase();
const places = porTipo(tipo);
const zonasCon = ZONAS.filter((z) => porZonaTipo(z, tipo).length > 0);
const canonical = tipoUrl(tipo, lang);
const alternates = altTipo(tipo);
const h1 = t(lang, 't_best', { p: pluralLow });
const intro = t(lang, 't_intro', { p: pluralLow, n: places.length });
const title = `${plural} · Costa Blanca (${places.length}) — Cometia`;

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(lang, 'nav_home'), item: SITE + homeUrl(lang) },
    { '@type': 'ListItem', position: 2, name: plural, item: SITE + canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: h1, numberOfItems: places.length,
    itemListElement: places.slice(0, 25).map((l, i) => ({ '@type': 'ListItem', position: i + 1, name: l.name, url: SITE + fichaUrl(l.slug, lang) })) },
];
---
<GuiaLayout title={title} description={intro} lang={lang} canonical={canonical} alternates={alternates} jsonLd={jsonLd}>
  <section class="ficha wrap">
    <div class="crumbs"><a href={homeUrl(lang)}>{t(lang, 'nav_home')}</a> › {plural}</div>
    <h1>{CATEGORIAS[tipo].icon} {h1}</h1>
    <p class="ficha__sub" style="max-width:760px">{intro}</p>
    <p class="count">{t(lang, 't_count', { n: places.length, p: pluralLow })}</p>

    {zonasCon.map((z) => {
      const items = porZonaTipo(z, tipo).sort((a, b) => (b.photo ? 1 : 0) - (a.photo ? 1 : 0) || a.name.localeCompare(b.name));
      return (
        <div class="section" style="padding:14px 0">
          <div class="sec__head">
            <h2>{t(lang, 't_inarea', { n: items.length, p: pluralLow, z })}</h2>
            <a class="sec__link" href={zonaTipoUrl(z, tipo, lang)}>{t(lang, 't_seeall', { n: items.length, p: pluralLow, z })}</a>
          </div>
          <div class="grid">
            {items.slice(0, 8).map((l) => <LugarCard l={l} lang={lang} />)}
          </div>
        </div>
      );
    })}
  </section>
</GuiaLayout>
