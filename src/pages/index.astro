---
import GuiaLayout from '../layouts/GuiaLayout.astro';
import { LUGARES, ZONAS, CATEGORIAS, TYPE_ORDER, TOTAL, N_FOTOS, porTipo, zonaUrl, tipoUrl } from '../data/guia/lugares';
import LugarCard from '../components/LugarCard.astro';

const porZona = (z: string) => LUGARES.filter((l) => l.zone === z).length;

// Destacados: con foto, equilibrado por zona (6 por zona).
const destacados = ZONAS.flatMap((z) => {
  const inZone = LUGARES.filter((l) => l.zone === z && l.photo).sort((a, b) => a.name.localeCompare(b.name));
  return inZone.slice(0, 6);
}).sort((a, b) => a.name.localeCompare(b.name));

const tipos = TYPE_ORDER.filter((t) => porTipo(t).length > 0);

const faqs = [
  { q: '¿Qué es Cometia?', a: `Cometia es una guía local e independiente de bares, restaurantes, pubs y cafeterías de la Costa Blanca: Gran Alacant, Santa Pola, Alicante y Elche. Reunimos ${TOTAL} sitios con dirección, mapa, horarios y una descripción clara de cada uno, en español e inglés.` },
  { q: '¿Es gratis?', a: 'Sí. Consultar la guía es totalmente gratis y sin registro. No vendemos posiciones ni publicamos reseñas falsas.' },
  { q: '¿De dónde salen los datos?', a: 'Los datos de los establecimientos proceden de OpenStreetMap (proyecto libre, licencia ODbL) y los completamos con geocodificación. Las descripciones son propias. Las valoraciones, cuando aparecen, enlazan a Google.' },
  { q: '¿Puedo ver los sitios en un mapa?', a: 'Sí. En el mapa interactivo puedes ver los sitios sobre el plano, filtrar por tipo y zona y pulsar cada pin para ver la ficha con foto.' },
];

const SITE = 'https://cometia.es';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Cometia', url: SITE + '/', inLanguage: 'es' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Cometia', url: SITE + '/', logo: SITE + '/favicon.svg',
    description: 'Guía local bilingüe de bares y restaurantes de la Costa Blanca (Gran Alacant, Santa Pola, Alicante y Elche).' },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Guía de bares y restaurantes de la Costa Blanca', url: SITE + '/', inLanguage: 'es' },
];
---
<GuiaLayout
  title="Bares y restaurantes de la Costa Blanca — Guía Cometia"
  description={`Guía local bilingüe de ${TOTAL} bares, restaurantes, pubs y cafeterías de Gran Alacant, Santa Pola, Alicante y Elche. Con mapa interactivo, horarios y descripciones. Español e inglés.`}
  lang="es"
  canonical="/"
  altUrl="/en/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="hero__eyebrow">Tu guía de la Costa Blanca</p>
      <h1>Dónde comer y tapear en <span class="grad">la Costa Blanca</span></h1>
      <p>Bares, restaurantes, pubs y cafeterías de Gran Alacant, Santa Pola, Alicante y Elche. Con mapa, horarios y ficha de cada sitio.</p>

      <div class="search-wrap">
        <div class="search"><input id="q" type="search" placeholder="Busca un bar o restaurante…" autocomplete="off" aria-label="Buscar sitio" role="combobox" aria-expanded="false" aria-controls="results" /><span class="loc">📍 Costa Blanca</span></div>
        <div class="results" id="results" role="listbox" aria-label="Resultados"></div>
      </div>

      <div class="hero__cta">
        <a class="btn-hero" href="/mapa">🗺️ Ver el mapa</a>
        <a class="btn-hero btn-hero--ghost" href="#zonas">Explorar por zona</a>
      </div>

      <div class="stats">
        <div><b>{TOTAL}</b><span>sitios</span></div>
        <div><b>{ZONAS.length}</b><span>zonas</span></div>
        <div><b>{N_FOTOS}</b><span>con foto</span></div>
        <div><b>ES · EN</b><span>bilingüe</span></div>
      </div>
    </div>
  </section>

  <section class="section wrap" id="zonas">
    <h2>Explora por zona</h2>
    <p class="lead">Elige tu ciudad y descubre todos los sitios para comer, tapear o tomar algo.</p>
    <div class="zonecards">
      {ZONAS.map((z) => (
        <a class="zonecard reveal" href={zonaUrl(z, 'es')}>
          <h3>{z}</h3><span>{porZona(z)} bares y restaurantes</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <h2>Explora por tipo</h2>
    <p class="lead">Restaurantes, bares de tapas, pubs, cafeterías y más — por toda la Costa Blanca.</p>
    <div class="typetiles">
      {tipos.map((t) => (
        <a class="typetile reveal" href={tipoUrl(t, 'es')}>
          <span class="ic">{CATEGORIAS[t].icon}</span>
          <span><b>{CATEGORIAS[t].plural_es}</b><span>{porTipo(t).length} sitios</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap" id="destacados">
    <div class="sec__head"><h2 style="font-family:var(--display);font-size:2.1rem;margin:0">Sitios destacados</h2><a class="sec__link" href="/mapa">Ver todos en el mapa →</a></div>
    <div class="grid">
      {destacados.map((l) => <LugarCard l={l} lang="es" />)}
    </div>
  </section>

  <section class="section wrap">
    <div class="mapband reveal">
      <h2>🗺️ Todos los sitios en un mapa</h2>
      <p>Explora los {TOTAL} bares y restaurantes sobre el plano. Filtra por tipo y zona y pulsa cada pin para ver fotos y la ficha completa.</p>
      <a class="btn-hero" href="/mapa">Abrir el mapa interactivo</a>
    </div>
  </section>

  <section class="section wrap">
    <h2>Por qué Cometia</h2>
    <div class="feats">
      <div class="feat reveal"><div class="ic">🍽️</div><h3>Todo en un sitio</h3><p>{TOTAL} bares y restaurantes de la Costa Blanca con dirección, horario, mapa y contacto.</p></div>
      <div class="feat reveal"><div class="ic">🇬🇧🇪🇸</div><h3>Bilingüe</h3><p>Cada ficha en español e inglés, pensada también para la comunidad británica de la zona.</p></div>
      <div class="feat reveal"><div class="ic">✅</div><h3>Sin postureo</h3><p>Datos reales de OpenStreetMap y descripciones propias. Ni reseñas falsas ni posiciones a la venta.</p></div>
      <div class="feat reveal"><div class="ic">🗺️</div><h3>Con mapa</h3><p>Encuentra lo que tienes cerca con el mapa interactivo y los filtros por tipo y zona.</p></div>
    </div>
  </section>

  <section class="section wrap">
    <h2>Preguntas frecuentes</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      var q = document.getElementById('q');
      var box = document.getElementById('results');
      if (!q || !box) return;
      var base = '/sitio/';
      var TL = { restaurante: ['🍽️', 'Restaurante'], bar: ['🍺', 'Bar'], pub: ['🍻', 'Pub'], cafeteria: ['☕', 'Cafetería'], 'comida-rapida': ['🍔', 'Comida rápida'], cerveceria: ['🍺', 'Cervecería'] };
      var idx = [], hi = -1, cur = [];
      function esc(s) { return String(s).replace(/[&<>"]/g, function (m) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]; }); }
      var loaded = false;
      function load() { if (loaded) return; loaded = true; fetch('/search-index.json').then(function (r) { return r.json(); }).then(function (d) { idx = d; run(); }); }
      function run() {
        var v = q.value.trim().toLowerCase();
        if (v.length < 2) { close(); return; }
        var starts = [], has = [];
        for (var i = 0; i < idx.length && has.length < 40; i++) {
          var n = idx[i].n.toLowerCase();
          if (n.indexOf(v) === 0) starts.push(idx[i]);
          else if (n.indexOf(v) > -1 || idx[i].z.toLowerCase().indexOf(v) > -1) has.push(idx[i]);
        }
        cur = starts.concat(has).slice(0, 8); hi = -1;
        if (!cur.length) { box.innerHTML = '<div class="empty">Sin resultados para “' + esc(q.value.trim()) + '”.</div>'; box.classList.add('is-open'); q.setAttribute('aria-expanded', 'true'); return; }
        box.innerHTML = cur.map(function (r) {
          var tl = TL[r.t] || ['📍', ''];
          return '<a class="result" role="option" href="' + base + r.s + '"><span class="ic">' + tl[0] + '</span><span class="nm">' + esc(r.n) + '</span><span class="mt">' + tl[1] + ' · ' + esc(r.z) + '</span></a>';
        }).join('');
        box.classList.add('is-open'); q.setAttribute('aria-expanded', 'true');
      }
      function close() { box.classList.remove('is-open'); q.setAttribute('aria-expanded', 'false'); hi = -1; }
      function move(d) { var els = box.querySelectorAll('.result'); if (!els.length) return; hi = (hi + d + els.length) % els.length; els.forEach(function (e, i) { e.classList.toggle('is-hi', i === hi); }); }
      q.addEventListener('focus', load);
      q.addEventListener('input', function () { if (loaded) run(); else load(); });
      q.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
        else if (e.key === 'Enter') { var els = box.querySelectorAll('.result'); if (hi > -1 && els[hi]) { location.href = els[hi].getAttribute('href'); } }
        else if (e.key === 'Escape') { close(); }
      });
      document.addEventListener('click', function (e) { if (!box.contains(e.target) && e.target !== q) close(); });
    })();
  </script>
</GuiaLayout>
