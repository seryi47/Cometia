---
import GuiaLayout from '../layouts/GuiaLayout.astro';
import LugarCard from './LugarCard.astro';
import { LUGARES, CATEGORIAS, TYPE_ORDER, tipoPlural, zonaUrl, zonaTipoUrl, altZona, fichaUrl } from '../data/guia/lugares';
import { t, zoneIntro, homeUrl, type Lang } from '../i18n';
export interface Props { zona: string; lang: Lang; }
const { zona, lang } = Astro.props;
const SITE = 'https://cometia.es';
const places = LUGARES.filter((l) => l.zone === zona).sort((a, b) => a.name.localeCompare(b.name));
const intro = zoneIntro(zona, lang);
const canonical = zonaUrl(zona, lang);
const alternates = altZona(zona);
const title = `${t(lang, 'zona_h1', { z: zona })} (${places.length}) — Cometia`;
const description = `${intro}`.slice(0, 300);

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(lang, 'nav_home'), item: SITE + homeUrl(lang) },
    { '@type': 'ListItem', position: 2, name: zona, item: SITE + canonical },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: title, numberOfItems: places.length,
    itemListElement: places.slice(0, 25).map((l, i) => ({ '@type': 'ListItem', position: i + 1, name: l.name, url: SITE + fichaUrl(l.slug, lang) })) },
];
---
<GuiaLayout title={title} description={description} lang={lang} canonical={canonical} alternates={alternates} jsonLd={jsonLd}>
  <section class="ficha wrap">
    <div class="crumbs"><a href={homeUrl(lang)}>{t(lang, 'nav_home')}</a> › {zona}</div>
    <h1>{t(lang, 'zona_h1', { z: zona })}</h1>
    <p class="ficha__sub" style="max-width:760px">{intro}</p>
    <p class="count">{places.length} {t(lang, 'z_places')}</p>

    {TYPE_ORDER.filter((ty) => places.some((l) => l.type === ty)).map((ty) => {
      const items = places.filter((l) => l.type === ty);
      const plural = tipoPlural(ty, lang);
      return (
        <div class="section" style="padding-top:8px">
          <div class="sec__head">
            <h2>{CATEGORIAS[ty].icon} {plural} <span style="color:var(--ink-2);font-weight:400;font-size:1rem">({items.length})</span></h2>
            {items.length > 12 && <a class="sec__link" href={zonaTipoUrl(zona, ty, lang)}>{t(lang, 'z_seeall', { n: items.length, p: plural.toLowerCase() })}</a>}
          </div>
          <div class="grid">
            {items.slice(0, 12).map((l) => <LugarCard l={l} lang={lang} />)}
          </div>
          {items.length > 12 && (
            <p style="margin-top:14px"><a class="chip" href={zonaTipoUrl(zona, ty, lang)}>{t(lang, 'z_seeall', { n: items.length, p: plural.toLowerCase() })}</a></p>
          )}
        </div>
      );
    })}

    <p style="margin-top:24px"><a class="chip" href={homeUrl(lang)}>{t(lang, 'z_back')}</a></p>
  </section>
</GuiaLayout>
