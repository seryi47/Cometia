---
import GuiaLayout from '../layouts/GuiaLayout.astro';
import { LUGARES, CATEGORIAS, TYPE_ORDER, ZONAS, TOTAL } from '../data/guia/lugares';
import LugarCard from '../components/LugarCard.astro';

const porZona = (z: string) => LUGARES.filter((l) => l.zone === z).length;

// Selección destacada: prioriza sitios con foto, equilibrado por zona (hasta 18 por zona).
const destacados = ZONAS.flatMap((z) => {
  const inZone = LUGARES.filter((l) => l.zone === z);
  const withP = inZone.filter((l) => l.photo).sort((a, b) => a.name.localeCompare(b.name));
  const rest = inZone.filter((l) => !l.photo).sort((a, b) => a.name.localeCompare(b.name));
  return [...withP, ...rest].slice(0, 18);
}).sort((a, b) => a.name.localeCompare(b.name));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Guía de bares y restaurantes de la Costa Blanca',
  url: 'https://cometia.es/',
  inLanguage: 'es',
  about: 'Bares, restaurantes, pubs y cafeterías de Gran Alacant, Santa Pola, Alicante y Elche (Costa Blanca).',
};
---
<GuiaLayout
  title="Bares y restaurantes de la Costa Blanca — Guía Cometia"
  description="Guía local de bares, restaurantes, pubs y cafeterías de Gran Alacant, Santa Pola, Alicante y Elche. Con mapa, horarios y descripciones. En español e inglés."
  lang="es"
  canonical="/"
  altUrl="/en/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="hero__eyebrow">Tu guía de la Costa Blanca</p>
      <h1>Dónde comer y tapear en <span class="grad">la Costa Blanca</span></h1>
      <p>La guía local de bares, restaurantes, pubs y cafeterías de Gran Alacant, Santa Pola, Alicante y Elche. {TOTAL} sitios con mapa, horario y ficha.</p>
      <div class="search"><input id="q" type="search" placeholder="Buscar en los destacados por nombre o tipo…" autocomplete="off" aria-label="Buscar" /><span class="loc">📍 Costa Blanca</span></div>
      <div class="chips" id="chips">
        <button class="chip is-active" data-f="tipo" data-v="">Todos</button>
        {TYPE_ORDER.filter((t) => LUGARES.some((l) => l.type === t)).map((t) => (
          <button class="chip" data-f="tipo" data-v={t}>{CATEGORIAS[t].icon} {CATEGORIAS[t].plural_es}</button>
        ))}
      </div>
      <div class="chips">
        {ZONAS.map((z) => (<a class="chip zona" href={`/${z === 'Gran Alacant' ? 'gran-alacant' : z === 'Santa Pola' ? 'santa-pola' : z === 'Alicante' ? 'alicante' : 'elche'}`}>📍 {z} ({porZona(z)})</a>))}
      </div>
      <div class="hero__cta">
        <a class="btn-hero" href="/mapa">🗺️ Ver el mapa</a>
        <a class="btn-hero btn-hero--ghost" href="/alicante">Explorar Alicante</a>
      </div>
    </div>
  </section>

  <section class="wrap" id="lista">
    <h2 class="section__h">Destacados de la zona</h2>
    <p class="count"><span id="count">{destacados.length}</span> sitios destacados · entra en cada zona para verlos todos</p>
    <div class="grid" id="grid">
      {destacados.map((l) => <LugarCard l={l} lang="es" />)}
    </div>
    <p class="noresults" id="noresults">No encontramos sitios con ese filtro. Prueba con otra palabra.</p>
  </section>

  <section class="section wrap">
    <h2>Explora por zona</h2>
    <p class="lead">Elige tu zona y descubre todos los sitios para comer, tapear o tomar algo.</p>
    <div class="zonecards">
      <a class="zonecard" href="/gran-alacant"><h3>Gran Alacant</h3><span>{porZona('Gran Alacant')} bares y restaurantes</span></a>
      <a class="zonecard" href="/santa-pola"><h3>Santa Pola</h3><span>{porZona('Santa Pola')} bares y restaurantes</span></a>
      <a class="zonecard" href="/alicante"><h3>Alicante</h3><span>{porZona('Alicante')} bares y restaurantes</span></a>
      <a class="zonecard" href="/elche"><h3>Elche</h3><span>{porZona('Elche')} bares y restaurantes</span></a>
    </div>
  </section>

  <script>
    const cards = Array.from(document.querySelectorAll('.lugar')) as HTMLElement[];
    const q = document.getElementById('q') as HTMLInputElement;
    const countEl = document.getElementById('count')!;
    const noRes = document.getElementById('noresults')!;
    let fTipo = '', fText = '';

    function apply() {
      let n = 0;
      cards.forEach((c) => {
        const ok = (!fTipo || c.dataset.tipo === fTipo)
          && (!fText || (c.dataset.name || '').includes(fText));
        c.style.display = ok ? '' : 'none';
        if (ok) n++;
      });
      countEl.textContent = String(n);
      noRes.style.display = n ? 'none' : 'block';
    }
    document.querySelectorAll('.chip[data-f]').forEach((ch) => {
      ch.addEventListener('click', () => {
        const f = (ch as HTMLElement).dataset.f, v = (ch as HTMLElement).dataset.v || '';
        if (f === 'tipo') fTipo = v;
        document.querySelectorAll(`.chip[data-f="${f}"]`).forEach((x) => x.classList.remove('is-active'));
        ch.classList.add('is-active');
        apply();
      });
    });
    q.addEventListener('input', () => { fText = q.value.trim().toLowerCase(); apply(); });

    const params = new URLSearchParams(location.search);
    const pt = params.get('tipo');
    if (pt) { const b = document.querySelector(`.chip[data-f="tipo"][data-v="${CSS.escape(pt)}"]`) as HTMLElement; if (b) b.click(); }
  </script>
</GuiaLayout>
