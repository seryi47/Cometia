---
import CalcLayout from '../layouts/CalcLayout.astro';
const faqs = [
  { q: '¿Cuánto debería ahorrar al mes?', a: 'Depende de tu meta y del plazo. Indica cuánto quieres reunir y en cuántos años, y te decimos la aportación mensual necesaria, teniendo en cuenta el interés que consigas.' },
  { q: '¿Por qué importa el interés?', a: 'Si inviertes lo que ahorras y obtienes rentabilidad, necesitarás aportar menos cada mes, porque los intereses también trabajan para ti.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Calculadora de ahorro', applicationCategory: 'FinanceApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, url: 'https://cometia.es/calculadora-ahorro' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<CalcLayout title="Calculadora de ahorro: cuánto guardar al mes para tu meta" description="Calcula cuánto ahorrar al mes para alcanzar tu objetivo en el plazo que quieras, con intereses. Gratis y sin registro." path="/calculadora-ahorro" jsonLd={jsonLd}>
  <div class="crumbs"><a href="/">Inicio</a> › Finanzas › Ahorro</div>
  <h1>Calculadora de ahorro</h1>
  <p class="lead">Descubre cuánto tienes que ahorrar al mes para alcanzar tu meta.</p>
  <div class="calc">
    <div class="row">
      <div class="field"><label for="m">Meta a alcanzar (€)</label><input class="input" id="m" type="number" inputmode="decimal" value="20000" min="0" /></div>
      <div class="field"><label for="y">Plazo (años)</label><input class="input" id="y" type="number" inputmode="numeric" value="5" min="1" /></div>
    </div>
    <div class="field"><label for="i">Interés anual (%)</label><input class="input" id="i" type="number" inputmode="decimal" value="2" step="0.1" min="0" /></div>
    <button class="btn" id="go" type="button">Calcular</button>
    <div class="result" id="res" hidden>
      <div class="hint">Ahorro mensual necesario</div>
      <div class="result__big num" id="pmt">—</div>
      <div style="margin-top:12px">
        <div class="result__row"><span>Total que aportarás</span><strong class="num" id="ap">—</strong></div>
        <div class="result__row"><span>Intereses ganados</span><strong class="num" id="in">—</strong></div>
      </div>
    </div>
  </div>
  <div class="adslot"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-6286326170489521" data-ad-slot="4016311751" data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script></div>
  <section class="prose">
    <h2>Cómo se calcula</h2>
    <p>Repartimos tu meta entre los meses del plazo, teniendo en cuenta que cada aportación genera intereses hasta el final. Con un interés del 0 % sería simplemente la meta dividida entre los meses; con interés, la aportación baja.</p>
    <h2>Preguntas frecuentes</h2>
    {faqs.map((f) => (<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
  </section>
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const eur = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 2 });
    function calc() {
      const fv = parseFloat(($('m') as HTMLInputElement).value) || 0;
      const y = parseInt(($('y') as HTMLInputElement).value) || 0;
      const ta = parseFloat(($('i') as HTMLInputElement).value) || 0;
      if (fv <= 0 || y <= 0) return;
      const r = ta / 100 / 12, n = y * 12;
      const pmt = r === 0 ? fv / n : fv * r / (Math.pow(1 + r, n) - 1);
      const aportado = pmt * n;
      ($('pmt')).textContent = eur.format(pmt);
      ($('ap')).textContent = eur.format(aportado);
      ($('in')).textContent = eur.format(fv - aportado);
      ($('res')).hidden = false;
    }
    $('go').addEventListener('click', calc);
    ['m','y','i'].forEach((id) => $(id).addEventListener('keydown', (e: any) => { if (e.key === 'Enter') calc(); }));
    calc();
  </script>
</CalcLayout>
