---
import CalcLayout from '../layouts/CalcLayout.astro';
const faqs = [
  { q: '¿Qué es el interés compuesto?', a: 'Es el interés que se calcula sobre el capital inicial y también sobre los intereses ya generados. Con el tiempo, esos intereses generan a su vez más intereses, y el crecimiento se acelera (efecto bola de nieve).' },
  { q: '¿Cómo influyen las aportaciones periódicas?', a: 'Si además del capital inicial añades una cantidad cada mes, cada aportación empieza a generar intereses desde que entra. Aportar de forma constante, aunque sea poco, tiene un gran efecto a largo plazo.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Calculadora de interés compuesto', applicationCategory: 'FinanceApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, url: 'https://cometia.es/calculadora-interes-compuesto' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<CalcLayout title="Calculadora de interés compuesto: haz crecer tus ahorros" description="Calcula cuánto crecerán tus ahorros con el interés compuesto y aportaciones mensuales. Ve el capital, lo aportado y los intereses ganados." path="/calculadora-interes-compuesto" jsonLd={jsonLd}>
  <div class="crumbs"><a href="/">Inicio</a> › Finanzas › Interés compuesto</div>
  <h1>Calculadora de interés compuesto</h1>
  <p class="lead">Descubre cuánto puede crecer tu dinero con el tiempo, el interés y las aportaciones que hagas.</p>
  <div class="calc">
    <div class="row">
      <div class="field"><label for="c">Capital inicial (€)</label><input class="input" id="c" type="number" inputmode="decimal" value="1000" min="0" /></div>
      <div class="field"><label for="m">Aportación mensual (€)</label><input class="input" id="m" type="number" inputmode="decimal" value="100" min="0" /></div>
    </div>
    <div class="row">
      <div class="field"><label for="i">Interés anual (%)</label><input class="input" id="i" type="number" inputmode="decimal" value="6" step="0.01" min="0" /></div>
      <div class="field"><label for="y">Años</label><input class="input" id="y" type="number" inputmode="numeric" value="20" min="1" /></div>
    </div>
    <button class="btn" id="go" type="button">Calcular</button>
    <div class="result" id="res" hidden>
      <div class="hint">Valor final</div>
      <div class="result__big num" id="fv">—</div>
      <div style="margin-top:12px">
        <div class="result__row"><span>Total aportado</span><strong class="num" id="ap">—</strong></div>
        <div class="result__row"><span>Intereses ganados</span><strong class="num" id="in">—</strong></div>
      </div>
    </div>
  </div>
  <div class="ad">Espacio publicitario</div>
  <section class="prose">
    <h2>Cómo funciona</h2>
    <p>El capital final se calcula capitalizando mes a mes el capital inicial y cada aportación al tipo de interés indicado. La fórmula combina el crecimiento del capital inicial, <strong>C·(1+r)<sup>n</sup></strong>, con el de las aportaciones periódicas, donde <strong>r</strong> es el interés mensual y <strong>n</strong> el número de meses.</p>
    <h2>Preguntas frecuentes</h2>
    {faqs.map((f) => (<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
  </section>
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const eur = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    function calc() {
      const C = parseFloat(($('c') as HTMLInputElement).value) || 0;
      const PMT = parseFloat(($('m') as HTMLInputElement).value) || 0;
      const ta = parseFloat(($('i') as HTMLInputElement).value) || 0;
      const y = parseInt(($('y') as HTMLInputElement).value) || 0;
      if (y <= 0) return;
      const r = ta / 100 / 12; const n = y * 12;
      const fv = r === 0 ? C + PMT * n : C * Math.pow(1 + r, n) + PMT * ((Math.pow(1 + r, n) - 1) / r);
      const aportado = C + PMT * n;
      ($('fv')).textContent = eur.format(fv);
      ($('ap')).textContent = eur.format(aportado);
      ($('in')).textContent = eur.format(fv - aportado);
      ($('res')).hidden = false;
    }
    $('go').addEventListener('click', calc);
    ['c','m','i','y'].forEach((id) => $(id).addEventListener('keydown', (e: any) => { if (e.key === 'Enter') calc(); }));
    calc();
  </script>
</CalcLayout>
