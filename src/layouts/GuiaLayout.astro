---
import '../styles/guia.css';
import { LANGS, LANG_META, t, homeUrl, type Lang } from '../i18n';
export interface Props {
  title: string;
  description: string;
  lang: Lang;
  canonical: string;                          // ruta relativa, ej "/" o "/sitio/zest"
  alternates?: Partial<Record<Lang, string>>; // misma página en cada idioma
  jsonLd?: any;
  noindex?: boolean;
  image?: string;
}
const { title, description, lang, canonical, alternates = {}, jsonLd, noindex, image } = Astro.props;
const SITE = 'https://cometia.es';
const abs = (p: string) => (p.startsWith('http') ? p : SITE + p);
const ogImage = abs(image || '/og.png');
const meta = LANG_META[lang];
// Idiomas disponibles para esta página (los que tienen alternativa) + el actual.
const langList = LANGS.filter((l) => alternates[l] || l === lang);
const xDefault = alternates['es'] || canonical;
---
<!doctype html>
<html lang={meta.htmlLang} data-lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={abs(canonical)} />
  {langList.map((l) => (
    <link rel="alternate" hreflang={LANG_META[l].htmlLang} href={abs(alternates[l] || canonical)} />
  ))}
  <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />
  <meta property="og:site_name" content="Cometia" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={abs(canonical)} />
  <meta property="og:locale" content={meta.ogLocale} />
  {langList.filter((l) => l !== lang).map((l) => (
    <meta property="og:locale:alternate" content={LANG_META[l].ogLocale} />
  ))}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Cometia" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#c81f33" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600;700&family=Caveat:wght@600;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600;700&family=Caveat:wght@600;700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600;700&family=Caveat:wght@600;700&display=swap" /></noscript>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <script is:inline>document.documentElement.classList.add('reveal-on');</script>
  <script type="application/json" id="cometia-alts" set:html={JSON.stringify(alternates)}></script>
  <script is:inline>
    (function () {
      var cur = document.documentElement.getAttribute('data-lang');
      var alts = {}; try { alts = JSON.parse(document.getElementById('cometia-alts').textContent || '{}'); } catch (e) {}
      var SUP = ['es', 'en', 'de', 'fr', 'nl', 'no', 'sv'];
      function getCookie(n) { var m = document.cookie.match('(?:^|; )' + n + '=([^;]*)'); return m ? decodeURIComponent(m[1]) : ''; }
      function setCookie(v) { try { document.cookie = 'clang=' + v + ';path=/;max-age=31536000;samesite=lax'; } catch (e) {} }
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('[data-setlang]');
        if (a) { setCookie(a.getAttribute('data-setlang')); }
      });
      var pref = getCookie('clang'), target = null;
      if (pref && SUP.indexOf(pref) > -1) { if (pref !== cur) target = pref; }
      else {
        try { if (sessionStorage.getItem('cometia_auto')) return; sessionStorage.setItem('cometia_auto', '1'); } catch (e) {}
        var navs = navigator.languages || [navigator.language || ''], best = null;
        for (var i = 0; i < navs.length && !best; i++) {
          var code = (navs[i] || '').slice(0, 2).toLowerCase();
          if (code === 'nb' || code === 'nn') code = 'no';
          if (SUP.indexOf(code) > -1) best = code;
        }
        if (best && best !== cur) target = best;
      }
      if (target && alts[target]) { location.replace(alts[target]); }
    })();
  </script>
</head>
<body>
  <header class="hdr">
    <div class="wrap hdr__in">
      <a class="brand" href={homeUrl(lang)} aria-label="Cometia">
        <span class="brand__mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#fffdf8" stroke-width="1.8" stroke-linecap="round">
            <circle cx="12" cy="12" r="7"/>
            <circle cx="12" cy="12" r="2.4" fill="#fffdf8" stroke="none"/>
          </svg>
        </span>
        <span class="brand__text">
          <span class="brand__name"><b>Come</b>tia</span>
          <span class="brand__tag">{t(lang, 'slogan')}</span>
        </span>
      </a>
      <nav class="nav">
        <a class="nav__map" href={lang === 'es' ? '/mapa' : LANG_META[lang].prefix + '/map'}>🗺️ {t(lang, 'nav_map')}</a>
        <a class="hide-md" href={lang === 'es' ? '/sobre' : LANG_META[lang].prefix + '/about'}>{t(lang, 'nav_about')}</a>
        <details class="langmenu">
          <summary aria-label={t(lang, 'langAria')}><span class="flag">{meta.flag}</span> <span class="hide-sm">{meta.label}</span> <span class="caret">▾</span></summary>
          <div class="langmenu__list">
            {LANGS.map((l) => (
              <a href={alternates[l] || homeUrl(l)} data-setlang={l} class={l === lang ? 'is-cur' : ''} hreflang={LANG_META[l].htmlLang}>
                <span class="flag">{LANG_META[l].flag}</span> {LANG_META[l].label}
              </a>
            ))}
          </div>
        </details>
        <a class="btn-contact" href={lang === 'es' ? '/contacto' : LANG_META[lang].prefix + '/contact'}>{t(lang, 'nav_contact')}</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="ftr">
    <div class="wrap">
      <div class="ftr__row">
        <a href={homeUrl(lang)}>{t(lang, 'nav_home')}</a>
        <a href={lang === 'es' ? '/sobre' : LANG_META[lang].prefix + '/about'}>{t(lang, 'nav_about')}</a>
        <a href={lang === 'es' ? '/contacto' : LANG_META[lang].prefix + '/contact'}>{t(lang, 'nav_contact')}</a>
        <a href={lang === 'es' ? '/privacidad' : LANG_META[lang].prefix + '/privacy'}>{t(lang, 'nav_privacy')}</a>
      </div>
      <p class="ftr__attr">{t(lang, 'foot_attr')}</p>
      <p class="ftr__attr">© {new Date().getFullYear()} Cometia · {t(lang, 'tagline')}</p>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window) || !els.length) { els.forEach(function (e) { e.classList.add('is-in'); }); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
      }, { rootMargin: '0px 0px -8% 0px' });
      els.forEach(function (e) { io.observe(e); });
    })();
  </script>
</body>
</html>
