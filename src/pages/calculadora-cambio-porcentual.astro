---
import CalcLayout from '../layouts/CalcLayout.astro';
const faqs = [
  { q: '¿Cómo se calcula la variación porcentual?', a: 'Restas el valor inicial al final, divides entre el inicial y multiplicas por 100: (final − inicial) / inicial × 100. Si sale positivo es una subida; si sale negativo, una bajada.' },
  { q: '¿Sirve para precios, sueldos o cualquier cosa?', a: 'Sí. Sirve para saber cuánto ha subido un precio, cuánto ha crecido una cifra de ventas, la variación de un sueldo, etc.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Calculadora de variación porcentual', applicationCategory: 'FinanceApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, url: 'https://cometia.es/calculadora-cambio-porcentual' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<CalcLayout title="Calculadora de variación porcentual (subida o bajada)" description="Calcula el porcentaje de subida o bajada entre dos valores. Ideal para precios, ventas o sueldos. Gratis y al instante." path="/calculadora-cambio-porcentual" jsonLd={jsonLd}>
  <div class="crumbs"><a href="/">Inicio</a> › Finanzas › Variación porcentual</div>
  <h1>Calculadora de variación porcentual</h1>
  <p class="lead">Cuánto ha subido o bajado algo entre dos valores, en porcentaje.</p>
  <div class="calc">
    <div class="row">
      <div class="field"><label for="i">Valor inicial</label><input class="input" id="i" type="number" inputmode="decimal" value="100" /></div>
      <div class="field"><label for="f">Valor final</label><input class="input" id="f" type="number" inputmode="decimal" value="125" /></div>
    </div>
    <button class="btn" id="go" type="button">Calcular</button>
    <div class="result" id="res" hidden><div class="hint">Variación</div><div class="result__big num" id="out">—</div></div>
  </div>
  <div class="adslot"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-6286326170489521" data-ad-slot="4016311751" data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script></div>
  <section class="prose">
    <h2>Cómo se calcula</h2>
    <p>La fórmula es <strong>(final − inicial) ÷ inicial × 100</strong>. Por ejemplo, de 100 a 125 hay una subida del 25%; de 125 a 100, una bajada del 20%. Ojo: subir y luego bajar el mismo porcentaje no te devuelve al punto de partida.</p>
    <h2>Preguntas frecuentes</h2>
    {faqs.map((f) => (<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    <div class="more"><a href="/calculadora-porcentaje">Porcentajes</a><a href="/calculadora-descuento">Descuento</a></div>
  </section>
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    function calc() {
      const i = parseFloat(($('i') as HTMLInputElement).value);
      const f = parseFloat(($('f') as HTMLInputElement).value);
      if (isNaN(i) || isNaN(f) || i === 0) { ($('out')).textContent = '—'; ($('res')).hidden = false; return; }
      const v = (f - i) / Math.abs(i) * 100;
      const txt = (v > 0 ? '▲ +' : v < 0 ? '▼ ' : '') + v.toFixed(2).replace('.', ',') + ' %';
      ($('out')).textContent = txt;
      ($('res')).hidden = false;
    }
    $('go').addEventListener('click', calc);
    ['i','f'].forEach((id) => $(id).addEventListener('keydown', (e: any) => { if (e.key === 'Enter') calc(); }));
    calc();
  </script>
</CalcLayout>
